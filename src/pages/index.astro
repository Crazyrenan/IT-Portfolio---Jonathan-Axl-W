---
import Layout from '../layouts/Layout.astro';
import { PixelHero } from '../components/retro/PixelHero';
import { RetroSkillsGrid } from '../components/retro/RetroSkillsGrid';
import { RetroProjectsDossier } from '../components/retro/RetroProjectsDossier';
import { RetroTimeline } from '../components/retro/RetroTimeline';
import { RetroTerminal } from '../components/retro/RetroTerminal';
import RetroTaskbar from '../components/retro/RetroTaskbar.astro';
---

<Layout title="Jonathan Axl Wibowo | 8-Bit Neo-Retro OS Portfolio">
  <main class="relative w-full overflow-hidden pb-16">

    <!-- ── Section 1: Hero Window (Profile.bmp) ── -->
    <div id="hero" class="scroll-mt-6">
      <PixelHero client:load />
    </div>

    <!-- ── Section 2: Skill Viewer (Skill_viewer.exe) ── -->
    <div id="skills" class="w-full scroll-mt-6">
      <RetroSkillsGrid client:visible />
    </div>

    <!-- ── Section 3: Project Explorer (Project_Explorer.exe) ── -->
    <div id="projects" class="w-full scroll-mt-6">
      <RetroProjectsDossier client:visible />
    </div>

    <!-- ── Section 4: Experience Log (Experience_Log.txt) ── -->
    <div id="experience" class="w-full scroll-mt-6">
      <RetroTimeline client:visible />
    </div>

    <!-- ── Section 5: Contact Terminal (Contact_Form.exe) ── -->
    <div id="contact" class="w-full scroll-mt-6">
      <RetroTerminal client:visible />
    </div>

  </main>
  
  <!-- System Taskbar -->
  <RetroTaskbar />
</Layout>
