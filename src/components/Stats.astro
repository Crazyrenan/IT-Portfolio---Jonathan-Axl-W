---
// Stats.astro — Verified real metrics banner
---

<section class="bg-[#223971] py-12 md:py-14 w-full relative z-10 shadow-inner">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
      
      <!-- Stat 1: Medical Detection Accuracy -->
      <div class="flex flex-col relative pl-4 border-l-4 border-[#FFC906]">
        <div class="font-mono text-3xl md:text-4xl font-bold text-white tracking-tight">97.0%</div>
        <div class="mt-2 text-base font-semibold text-white/90 leading-snug">Akurasi Deteksi Medis</div>
        <div class="mt-1 text-sm text-white/60">Riset IEEE YESIST12</div>
      </div>
      
      <!-- Stat 2: Ticket Duplication Reduction -->
      <div class="flex flex-col relative pl-4 border-l-4 border-[#CB2026]">
        <div class="font-mono text-3xl md:text-4xl font-bold text-white tracking-tight">40%</div>
        <div class="mt-2 text-base font-semibold text-white/90 leading-snug">Reduksi Duplikasi Tiket</div>
        <div class="mt-1 text-sm text-white/60">Intelligent Help Desk</div>
      </div>
      
      <!-- Stat 3: Academic GPA -->
      <div class="flex flex-col relative pl-4 border-l-4 border-white/80">
        <div class="font-mono text-3xl md:text-4xl font-bold text-white tracking-tight">3.78</div>
        <div class="mt-2 text-base font-semibold text-white/90 leading-snug">IPK Akademik</div>
        <div class="mt-1 text-sm text-white/60">Sistem Informasi, UMN</div>
      </div>
      
      <!-- Stat 4: Enterprise Systems -->
      <div class="flex flex-col relative pl-4 border-l-4 border-[#FFC906]">
        <div class="font-mono text-3xl md:text-4xl font-bold text-white tracking-tight">3+</div>
        <div class="mt-2 text-base font-semibold text-white/90 leading-snug">Sistem Enterprise</div>
        <div class="mt-1 text-sm text-white/60">Skala Produksi Terverifikasi</div>
      </div>

    </div>
  </div>
</section>
