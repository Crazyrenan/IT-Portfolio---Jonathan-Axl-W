---
// Hero.astro — Professional Hero Section
---

<section id="hero" class="py-20 md:py-28 w-full">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col lg:flex-row gap-12 lg:gap-16 items-center">
      
      <!-- Left Content -->
      <div class="w-full lg:w-[60%] flex flex-col justify-center">
        <span class="font-mono text-xs tracking-[0.2em] uppercase text-[#223971] font-semibold mb-4 block">
          Full-Stack Engineer &times; Deep Learning Researcher
        </span>
        
        <h1 class="font-display text-4xl sm:text-5xl lg:text-6xl font-extrabold text-[#111827] tracking-tight leading-[1.15]">
          Rekayasa Sistem Skalabel &amp; Kecerdasan Buatan Terapan
        </h1>
        
        <p class="text-base sm:text-lg text-[#4B5563] mt-6 max-w-xl leading-relaxed">
          Menggabungkan arsitektur full-stack modern (React 18, FastAPI, Laravel) dengan riset kecerdasan buatan terapan (IEEE YESIST12) untuk merancang dan membangun sistem berskala produksi yang andal.
        </p>
        
        <div class="mt-8 flex flex-col sm:flex-row gap-4">
          <a href="#projects" class="inline-flex justify-center items-center bg-[#CB2026] text-white px-6 py-3.5 rounded-lg font-semibold hover:bg-[#a81a1f] transition shadow-lg shadow-red-500/20 text-center text-sm">
            Lihat Studi Kasus
          </a>
          <a href="/cv.pdf" target="_blank" rel="noopener noreferrer" class="inline-flex justify-center items-center border-2 border-[#223971] text-[#223971] px-6 py-3.5 rounded-lg font-semibold hover:bg-[#223971] hover:text-white transition text-center text-sm">
            Unduh Resume (PDF)
          </a>
        </div>
      </div>
      
      <!-- Right Image -->
      <div class="w-full sm:max-w-md lg:w-[40%]">
        <div class="relative group">
          <div class="absolute -inset-1 bg-gradient-to-r from-[#223971] to-[#CB2026] rounded-2xl blur opacity-20 group-hover:opacity-35 transition duration-500"></div>
          <div class="relative rounded-2xl overflow-hidden shadow-xl border-2 border-[#223971]/15 bg-white aspect-[4/5]">
            <img 
              id="hero-profile-img"
              src="/images/me.jpg" 
              alt="Jonathan Axl Wibowo" 
              class="w-full h-full object-cover object-top" 
              loading="eager"
            />
          </div>
        </div>
      </div>
      
    </div>
  </div>
</section>

<script>
  const img = document.getElementById('hero-profile-img') as HTMLImageElement | null;
  if (img) {
    img.addEventListener('error', () => {
      img.src = '/images/me 2.png';
    }, { once: true });
  }
</script>
