<section id="manifesto" class="py-32 md:py-40 flex items-center justify-center relative z-10 bg-transparent px-6 overflow-hidden">

  <!-- Subtle accent glow -->
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[300px] bg-primary/5 blur-[120px] rounded-full pointer-events-none" aria-hidden="true"></div>

  <div class="max-w-5xl mx-auto relative z-10">

    <!-- Section label -->
    <div id="manifesto-label" class="flex items-center gap-3 mb-14 opacity-0 translate-y-8 transition-all duration-700 ease-out">
      <span class="inline-flex items-center gap-2 px-3 py-1 border border-primary/40 bg-primary/10 font-mono text-[11px] tracking-[0.2em] text-primary-glow uppercase">
        <span class="w-1.5 h-1.5 rounded-full bg-primary-glow animate-pulse"></span>
        MANIFESTO // IDENTITY_VERIFIED
      </span>
      <span class="h-px flex-1 bg-gradient-to-r from-primary/30 to-transparent hidden md:block"></span>
    </div>

    <!-- Primary statement -->
    <div id="manifesto-headline" class="mb-10 opacity-0 translate-y-8 transition-all duration-700 ease-out delay-100">
      <h2 class="text-4xl md:text-6xl lg:text-7xl font-bold text-text leading-[1.08] tracking-tight mb-5">
        Full-Stack Architecture<br />
        <span class="text-text/30 font-light italic text-3xl md:text-5xl lg:text-6xl">&amp; AI Data Systems.</span>
      </h2>
      <p class="text-base md:text-lg font-mono text-text/50 tracking-wide">
        Two disciplines. One integrated engineering practice.
      </p>
    </div>

    <!-- Three-column principle grid -->
    <div id="manifesto-principles" class="grid grid-cols-1 md:grid-cols-3 gap-px bg-primary/10 border border-primary/15 mb-14 opacity-0 translate-y-8 transition-all duration-700 ease-out delay-200">
      
      <div class="bg-surface/60 backdrop-blur-sm p-6 md:p-8 group hover:bg-surface/90 transition-colors duration-300">
        <div class="font-mono text-[10px] text-primary-glow tracking-[0.2em] uppercase mb-3">MODULE_01 // BACKEND</div>
        <h3 class="font-bold text-text text-lg mb-3 leading-snug">Systems That Scale</h3>
        <p class="font-mono text-xs text-text/50 leading-relaxed">
          Laravel &amp; FastAPI architectures built for enterprise load — cryptographic integrity, RBAC, atomic transactions.
        </p>
        <div class="mt-4 flex flex-wrap gap-1.5">
          {['Laravel', 'FastAPI', 'PostgreSQL', 'Python'].map(t => (
            <span class="font-mono text-[10px] px-2 py-0.5 border border-primary/30 text-text/50 bg-primary/5">{t}</span>
          ))}
        </div>
      </div>

      <div class="bg-surface/60 backdrop-blur-sm p-6 md:p-8 group hover:bg-surface/90 transition-colors duration-300">
        <div class="font-mono text-[10px] text-primary-glow tracking-[0.2em] uppercase mb-3">MODULE_02 // FRONTEND</div>
        <h3 class="font-bold text-text text-lg mb-3 leading-snug">Interfaces That Move</h3>
        <p class="font-mono text-xs text-text/50 leading-relaxed">
          React islands, GSAP motion, Astro SSG — crafting high-performance UI that communicates engineering craft.
        </p>
        <div class="mt-4 flex flex-wrap gap-1.5">
          {['React', 'Astro', 'GSAP', 'TypeScript'].map(t => (
            <span class="font-mono text-[10px] px-2 py-0.5 border border-primary/30 text-text/50 bg-primary/5">{t}</span>
          ))}
        </div>
      </div>

      <div class="bg-surface/60 backdrop-blur-sm p-6 md:p-8 group hover:bg-surface/90 transition-colors duration-300">
        <div class="font-mono text-[10px] text-primary-glow tracking-[0.2em] uppercase mb-3">MODULE_03 // AI&amp;DATA</div>
        <h3 class="font-bold text-text text-lg mb-3 leading-snug">Models That Reason</h3>
        <p class="font-mono text-xs text-text/50 leading-relaxed">
          Vision Transformers, hybrid CNNs, Grad-CAM interpretability — IEEE-standard research driving clinical-grade accuracy.
        </p>
        <div class="mt-4 flex flex-wrap gap-1.5">
          {['PyTorch', 'TensorFlow', 'Swin-T', 'Grad-CAM'].map(t => (
            <span class="font-mono text-[10px] px-2 py-0.5 border border-primary/30 text-text/50 bg-primary/5">{t}</span>
          ))}
        </div>
      </div>
    </div>

    <!-- Extended narrative -->
    <div id="manifesto-body" class="max-w-3xl mx-auto space-y-5 opacity-0 translate-y-8 transition-all duration-700 ease-out delay-300">
      <p class="text-base md:text-lg text-text/65 leading-relaxed">
        I operate at the intersection where <span class="text-text font-semibold">infrastructure meets intelligence</span> — engineering production systems that don't just serve data, but understand it.
      </p>
      <p class="text-sm md:text-base text-text/45 font-mono leading-relaxed">
        From blockchain-secured field service portals to 97%-accuracy TB detection models published in IEEE proceedings, the throughline is the same: <span class="text-primary-glow">precision engineering under real constraints</span>.
      </p>
    </div>

  </div>
</section>

<script>
  function initManifesto() {
    const reduceMotion = window.matchMedia?.('(prefers-reduced-motion: reduce)').matches;

    const ids = ['manifesto-label', 'manifesto-headline', 'manifesto-principles', 'manifesto-body'];
    const elements = ids.map(id => document.getElementById(id)).filter(Boolean) as HTMLElement[];

    if (reduceMotion) {
      elements.forEach(el => el.classList.remove('opacity-0', 'translate-y-8'));
      return;
    }

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.remove('opacity-0', 'translate-y-8');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.15 });

    elements.forEach(el => observer.observe(el));
  }

  initManifesto();
  document.addEventListener('astro:after-swap', initManifesto);
</script>

