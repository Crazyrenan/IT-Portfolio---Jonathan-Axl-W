<section id="manifesto" class="min-h-screen flex items-center justify-center relative z-10 bg-transparent px-6 transition-colors duration-500">
  <div class="max-w-4xl mx-auto text-center">
    
    <div id="manifesto-content" class="manifesto-text space-y-12 opacity-0 translate-y-20 filter blur-sm">
      <p class="text-xl md:text-2xl font-mono text-primary tracking-widest uppercase">
        // IDENTITY VERIFIED
      </p>
      
      <h2 class="text-4xl md:text-6xl font-bold text-text leading-tight">
        I don't just build websites. <br />
        <span class="text-text/40 italic">I engineer intelligent systems.</span>
      </h2>
      
      <p class="text-xl text-text/70 max-w-2xl mx-auto leading-relaxed font-mono">
        Leveraging <span class="text-primary font-bold">Laravel</span> for structure, 
        <span class="text-primary font-bold">Python</span> for logic, and 
        <span class="text-primary font-bold">AI</span> for foresight.
      </p>
    </div>

  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  // FIX: Wrap in astro:page-load so it works after returning from slug pages
  document.addEventListener('astro:page-load', () => {
    gsap.to(".manifesto-text", {
      scrollTrigger: {
        trigger: "#manifesto",
        start: "top 80%", // Moved up slightly to ensure it triggers earlier
        toggleActions: "play none none reverse",
        // Re-calculate positions to prevent "missing" elements
        onRefresh: (self) => {
          if (self.progress > 0) gsap.set(".manifesto-text", { opacity: 1, y: 0, filter: "blur(0px)" });
        }
      },
      opacity: 1,
      y: 0,
      filter: "blur(0px)",
      duration: 1.5,
      ease: "power4.out", // Smoother exit
    });
  });
</script>