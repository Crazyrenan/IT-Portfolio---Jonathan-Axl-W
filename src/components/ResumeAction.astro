---
const resumePath = "/cv.pdf"; 
---

<a 
  href={resumePath} 
  download="JonathanAxl_Resume_2026.pdf"
  class="group relative inline-flex items-center gap-3 px-6 py-3 bg-surface border border-primary/30 hover:border-primary/100 transition-all duration-300"
>
  <div class="absolute inset-0 bg-primary/10 w-0 group-hover:w-full transition-all duration-300 ease-out"></div>

  <div class="relative z-10 flex items-center justify-center w-6 h-6 border border-primary/50 rounded-sm group-hover:bg-primary group-hover:text-white transition-colors">
    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-3 h-3">
      <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M12 12.75l-3-3m3 3l3-3m-3 3V3" />
    </svg>
  </div>

  <div class="relative z-10 flex flex-col items-start">
    <span class="text-[10px] font-mono text-primary/70 tracking-widest uppercase group-hover:text-primary transition-colors">
      Personnel File
    </span>
    <span class="text-sm font-bold text-white tracking-wide font-sans">
      DOWNLOAD_CV
    </span>
  </div>

  <div class="absolute top-0 right-0 w-2 h-2 border-t border-r border-primary opacity-50 group-hover:opacity-100 transition-opacity"></div>
</a>