---
import PhotoFrame from './PhotoFrame.astro';
---

<section id="about" class="py-24 px-6 max-w-6xl mx-auto relative">
  
  <div class="absolute -right-20 top-0 text-[10rem] font-bold text-text/5 pointer-events-none select-none font-mono leading-none hidden md:block">
    BIO
  </div>

  <div class="flex flex-col md:flex-row gap-16 items-center relative z-10">
    
    <div class="flex-1 space-y-8 text-center md:text-left order-2 md:order-1">
      <div>
        <span class="font-mono text-primary text-xs tracking-widest uppercase block mb-2">
          // PERSONNEL FILE
        </span>
        <h2 class="text-4xl font-bold text-text">
          Operator Profile
        </h2>
      </div>

      <div class="space-y-6 text-lg text-neutral/80 leading-relaxed">
        <p>
          I’m <strong class="text-text">Jonathan Axl Wibowo</strong>, a Full-Stack Engineer and high-honors student at Multimedia Nusantara University (GPA 3.78). My mission is to bridge the gap between robust backend architecture and intuitive user experiences.
        </p>
        <p>
          I don't just write code; I engineer <strong class="text-text">intelligent systems</strong>. Whether it's optimizing complex SQL queries for real-time analytics or training AI models to solve real-world problems, I bring a tactical, data-driven approach to every challenge.
        </p>
        <p>
          When I'm not deploying code, you'll find me obsessing over the science of <strong class="text-primary">coffee processing</strong>—applying the same precision to my brew as I do to my algorithms.
        </p>
      </div>

      <div class="pt-4">
        <a href="#contact" class="inline-flex items-center px-6 py-3 bg-primary/10 border border-primary text-primary hover:bg-primary hover:text-text transition-all rounded-sm font-mono text-sm group">
          <span>INITIATE CONTACT</span>
          <svg class="w-4 h-4 ml-2 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </div>
    </div>

    <div class="flex-1 flex justify-center order-1 md:order-2">
      <PhotoFrame />
    </div>

  </div>
</section>