---
import PhotoFrame from './PhotoFrame.astro';
---

<section id="about" class="py-28 md:py-32 pb-36 px-6 max-w-6xl mx-auto relative h-auto z-20">
  
  <div class="absolute -right-10 top-0 text-[10rem] font-bold text-[#E0D5C9]/5 pointer-events-none select-none font-mono leading-none hidden md:block z-0 overflow-hidden">
    BIO
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start relative z-10">
    
    <!-- Bio & Academic Log Column -->
    <div class="lg:col-span-8 space-y-10 text-center md:text-left order-2 lg:order-1 h-auto">
      
      <div>
        <span class="font-mono text-[#D12636] text-xs tracking-widest uppercase block mb-2">
          // PERSONNEL FILE: 001
        </span>
        <h2 class="text-4xl md:text-5xl font-bold text-[#E0D5C9] tracking-tight">
          About <span class="text-[#D12636]">Me</span>
        </h2>
      </div>

      <div class="space-y-6 text-base md:text-lg text-[#E0D5C9]/80 leading-relaxed">
        <p>
          I’m <strong class="text-[#E0D5C9]">Jonathan Axl Wibowo</strong>, a Full-Stack Engineer and a high-honors student at Multimedia Nusantara University. I specialize in building reliable backend systems and creating intuitive user experiences.
        </p>
        <p>
          I approach code with a focus on <strong class="text-[#E0D5C9]">practicality and scalability</strong>. My experience ranges from optimizing SQL queries for real-time analytics to deploying AI models for tangible business solutions. I value clear logic, clean architecture, and software that performs under pressure.
        </p>
        <p>
          Outside of tech, I’m interested in the science behind <strong class="text-[#D12636]">coffee processing</strong>. It’s a space where precision, experimentation, and consistency matter—values that deeply shape my engineering philosophy.
        </p>
      </div>

      <div class="pt-4">
        <h3 class="text-xs font-mono text-[#D12636]/80 mb-6 flex items-center justify-center md:justify-start gap-2 uppercase tracking-widest">
          <span class="w-1.5 h-1.5 bg-[#D12636] rounded-full animate-pulse"></span>
          Academic_Log
        </h3>

        <div class="relative pl-8 border-l border-[#681826]/40 ml-4 md:ml-0 text-left">
          <div class="absolute -left-[5px] top-0 w-2.5 h-2.5 bg-[#0F0F11] border border-[#D12636] rounded-full shadow-[0_0_10px_rgba(209,38,54,0.6)]"></div>
          
          <div class="flex flex-col sm:flex-row sm:items-center justify-between mb-2 gap-2">
            <h4 class="text-xl font-bold text-[#E0D5C9] font-sans">Multimedia Nusantara University</h4>
            <span class="inline-block font-mono text-[10px] text-[#D12636] bg-[#681826]/20 border border-[#681826]/40 px-2 py-1 rounded-xs">
              2022 — PRESENT
            </span>
          </div>
          
          <div class="mb-5">
            <p class="text-[#E0D5C9]/60 font-mono text-sm">Bachelor of Information Systems</p>
          </div>

          <div class="inline-flex flex-wrap sm:flex-nowrap items-center gap-6 bg-[#1B1B1E]/90 border border-[#681826]/40 p-5 rounded-xs relative overflow-visible group hover:border-[#D12636] transition-colors shadow-lg max-w-full">
            <div class="absolute top-0 right-0 w-2 h-2 border-t border-r border-[#D12636]/60"></div>

            <div class="text-center px-2 sm:border-r border-[#681826]/30">
              <span class="block text-[10px] text-[#E0D5C9]/40 font-mono uppercase tracking-wider">GPA Score</span>
              <span class="text-2xl font-bold text-[#D12636] font-mono">3.50</span>
            </div>
            
            <div class="flex-1 min-w-[140px] w-full sm:w-auto">
              <div class="flex justify-between text-[10px] text-[#E0D5C9]/40 font-mono uppercase mb-1.5">
                <span>Completion</span>
                <span>94%</span>
              </div>
              <div class="h-1.5 w-full bg-[#0F0F11] rounded-full overflow-hidden">
                <div class="h-full bg-[#D12636] w-[94%] shadow-[0_0_10px_rgba(209,38,54,0.8)]"></div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="pt-8 pb-4">
        <a href="#contact" class="inline-flex items-center px-8 py-4 bg-[#681826]/20 border border-[#681826]/60 text-[#E0D5C9] hover:bg-[#D12636] hover:text-[#0F0F11] hover:border-[#D12636] transition-all duration-300 rounded-xs font-mono text-sm tracking-widest group relative overflow-hidden shadow-lg">
          <span class="relative z-10 flex items-center font-bold">
            INITIATE_CONTACT
            <svg class="w-4 h-4 ml-2 group-hover:translate-x-1 transition-transform duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </span>
          <div class="absolute inset-0 bg-[#D12636] translate-y-full group-hover:translate-y-0 transition-transform duration-300 ease-out z-0"></div>
        </a>
      </div>

    </div>

    <!-- Polaroid Photo Frame Column -->
    <div class="lg:col-span-4 flex justify-center lg:justify-end order-1 lg:order-2 w-full pt-4 lg:pt-8 sticky top-28">
      <PhotoFrame />
    </div>

  </div>
</section>
