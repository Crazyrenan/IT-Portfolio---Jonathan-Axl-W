---
// MissionLog.astro - The "Experience" Section
const history = [
  {
    role: "IT Application Developer",
    company: "Indonesia Morowali Industrial Park (IMIP)",
    period: "2025 — 2026",
    details: [
      "Developed a full-stack e-recruitment platform using designated frameworks.",
      "Optimized database queries, reducing load times by 40%.",
      "Collaborated with HR teams to digitize the applicant tracking process."
    ]
  },
  {
    role: "Freelance Editor",
    company: "None",
    period: "2022 — 2025",
    details: [
      "Creating VFX and managing color correction'.",
      "Helping to create company profile video",
      "Managing and leading Information System documentation team."
    ]
  },
  // Add more if you have them!
];
---

<section id="experience" class="py-20 relative border-t border-white/5">
  <div class="container mx-auto px-6">
    
    <div class="flex items-end gap-4 mb-16">
      <h2 class="text-4xl md:text-6xl font-bold text-white">
        Work <span class="text-primary">Experience</span>
      </h2>
      <span class="font-mono text-primary/50 text-sm mb-2">// SERVICE_RECORD</span>
    </div>

    <div class="relative space-y-12 pl-4 md:pl-0">
      <div class="absolute left-4 top-0 bottom-0 w-px bg-white/10 hidden md:block md:left-1/2"></div>

      {history.map((item, index) => (
        <div class={`relative flex flex-col md:flex-row gap-8 ${index % 2 === 0 ? 'md:flex-row-reverse' : ''}`}>
          
          <div class="absolute left-4 md:left-1/2 w-3 h-3 bg-primary rounded-full border-4 border-background transform -translate-x-1/2 mt-1.5 z-10 hidden md:block"></div>

          <div class="md:w-1/2">
            <div class={`bg-surface/30 p-6 border border-white/5 hover:border-primary/30 transition-colors duration-300 relative group ${index % 2 === 0 ? 'md:mr-8' : 'md:ml-8'}`}>
              
              {/* Decorative Corner */}
              <div class="absolute top-0 right-0 w-4 h-4 border-t border-r border-primary/20 group-hover:border-primary transition-colors"></div>

              <div class="flex justify-between items-start mb-2">
                <h3 class="text-xl font-bold text-white group-hover:text-primary transition-colors">
                  {item.role}
                </h3>
                <span class="font-mono text-xs text-primary/80 bg-primary/10 px-2 py-1 rounded-sm">
                  {item.period}
                </span>
              </div>
              
              <h4 class="text-sm font-mono text-white/50 mb-4 uppercase tracking-wider">
                @ {item.company}
              </h4>

              <ul class="space-y-2">
                {item.details.map(detail => (
                  <li class="flex items-start gap-2 text-sm text-text/70">
                    <span class="mt-1.5 w-1 h-1 bg-primary/50 rounded-full"></span>
                    {detail}
                  </li>
                ))}
              </ul>

            </div>
          </div>
          
          <div class="md:w-1/2"></div>
        </div>
      ))}
    </div>

  </div>
</section>