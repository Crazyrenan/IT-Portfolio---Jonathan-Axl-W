---
interface TechItem {
  name: string;
  role: string;
  status?: string;
}

interface StackGroup {
  id: string;
  category: string;
  codename: string;
  badge: string;
  description: string;
  items: TechItem[];
  colSpan: string;
}

const stack: StackGroup[] = [
  {
    id: "MOD_01",
    category: "Core Engine",
    codename: "BACKEND_SYSTEMS",
    badge: "SYS.CORE // v4.2",
    description: "High-throughput server architectures, typed runtimes & relational databases.",
    colSpan: "lg:col-span-7",
    items: [
      { name: "Laravel", role: "Fullstack / API", status: "READY" },
      { name: "Python", role: "Data / Scripting", status: "READY" },
      { name: "TypeScript", role: "Typed Execution", status: "READY" },
      { name: "PostgreSQL", role: "Relational DB", status: "READY" },
      { name: "PHP", role: "Core Runtime", status: "READY" }
    ]
  },
  {
    id: "MOD_02",
    category: "Frontend Interface",
    codename: "CLIENT_SURFACE",
    badge: "UI.SURFACE // v3.8",
    description: "Reactive UI paradigms, island hydration & hardware-accelerated motions.",
    colSpan: "lg:col-span-5",
    items: [
      { name: "React", role: "Component Arch", status: "READY" },
      { name: "Astro", role: "Island SSR / SSG", status: "READY" },
      { name: "Tailwind", role: "Design Tokenizer", status: "READY" },
      { name: "GSAP", role: "Motion Engine", status: "READY" },
      { name: "Figma", role: "Vector & UI Prototyping", status: "READY" }
    ]
  },
  {
    id: "MOD_03",
    category: "Machine Intelligence",
    codename: "NEURAL_NETWORKS",
    badge: "AI.TENSOR // v2.4",
    description: "Computer vision pipelines, deep neural topologies & transformer models.",
    colSpan: "lg:col-span-5",
    items: [
      { name: "TensorFlow", role: "Deep Learning", status: "READY" },
      { name: "HuggingFace", role: "Transformers & LLMs", status: "READY" },
      { name: "OpenCV", role: "Vision Processing", status: "READY" },
      { name: "PyTorch", role: "Neural Framework", status: "READY" }
    ]
  },
  {
    id: "MOD_04",
    category: "DevOps & Cloud",
    codename: "INFRA_PIPELINES",
    badge: "OPS.INFRA // v5.1",
    description: "Containerization clusters, server environments & reverse-proxy routing.",
    colSpan: "lg:col-span-7",
    items: [
      { name: "Docker", role: "Container Runtime", status: "READY" },
      { name: "Git", role: "Version Protocol", status: "READY" },
      { name: "Linux", role: "Kernel & OS", status: "READY" },
      { name: "Nginx", role: "Proxy / Gateway", status: "READY" }
    ]
  }
];

const getIcon = (name: string) => {
  const map: Record<string, string> = {
    "Tailwind": "tailwindcss",
    "GSAP": "greensock",
    "SQL": "database",
    "C++": "cplusplus",
    "C#": "csharp",
    ".NET": "dotnet",
    "HuggingFace": "huggingface",
    "TensorFlow": "tensorflow",
    "PyTorch": "pytorch",
    "OpenCV": "opencv",
    "PostgreSQL": "postgresql"
  };
  
  const slug = map[name] || name.toLowerCase().replace(/\s+/g, '');
  return `https://cdn.simpleicons.org/${slug}/E0D5C9`;
};
---

<section id="tech-arsenal" class="py-24 px-6 max-w-6xl mx-auto relative overflow-hidden">
  
  <!-- Tactical Background Grid & Ambience -->
  <div class="absolute inset-0 pointer-events-none -z-10 overflow-hidden">
    <div class="absolute inset-0 bg-[#0F0F11]"></div>
    <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[350px] bg-[#681826]/15 blur-[120px] rounded-full pointer-events-none"></div>
    <div class="absolute bottom-10 right-10 w-[400px] h-[250px] bg-[#681826]/10 blur-[100px] rounded-full pointer-events-none"></div>
    <div class="absolute inset-0 opacity-[0.07] bg-[radial-gradient(#E0D5C9_1px,transparent_1px)] [background-size:24px_24px]"></div>
  </div>

  <!-- Tactical Section Header -->
  <div class="mb-14 relative z-10">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 pb-6 border-b border-[#681826]/30">
      <div>
        <div class="flex items-center gap-3 mb-3">
          <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-xs bg-[#681826]/20 border border-[#681826]/50 text-[#D12636] font-mono text-[11px] uppercase tracking-widest">
            <span class="w-1.5 h-1.5 rounded-full bg-[#D12636] animate-pulse"></span>
            SYS.CAPABILITIES // ARSENAL_MATRIX
          </span>
          <span class="text-white/20 font-mono text-xs hidden sm:inline">[SEC_LEVEL_04]</span>
        </div>
        <h2 class="text-3xl md:text-5xl font-bold text-white tracking-tight flex items-center gap-3">
          Tech Arsenal
          <span class="text-xs font-mono text-white/40 font-normal px-2 py-1 bg-white/5 border border-white/10 rounded-xs">
            18 MODULES
          </span>
        </h2>
      </div>

      <!-- Telemetry Status Bar -->
      <div class="flex flex-col items-start md:items-end gap-1.5 font-mono text-xs">
        <div class="flex items-center gap-2 text-white/60">
          <span class="text-[#681826] font-bold">STATUS:</span>
          <span class="text-emerald-400">OPERATIONAL [100%]</span>
        </div>
        <div class="inline-flex items-center gap-2 px-3 py-1.5 bg-[#0F0F11] border border-[#681826]/40 rounded-xs text-[#E0D5C9]/70 text-[11px]">
          <span class="w-2 h-2 rounded-full bg-[#681826] animate-ping"></span>
          <span>CLICK MODULE NODE TO INITIALIZE RAIN PROTOCOL</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Interactive Bento Grid -->
  <div class="grid grid-cols-1 md:grid-cols-1 lg:grid-cols-12 gap-6 relative z-10">
    {stack.map((group) => (
      <div class={`col-span-12 ${group.colSpan} relative bg-[#0F0F11]/90 backdrop-blur-md border border-[#681826]/30 p-6 md:p-7 rounded-xs group hover:border-[#681826] transition-all duration-500 hover:shadow-[0_0_30px_rgba(104,24,38,0.2)] flex flex-col justify-between overflow-hidden`}>
        
        <!-- Tactical Corner Reticles / Brackets -->
        <div class="absolute top-0 left-0 w-3 h-3 border-t-2 border-l-2 border-[#681826]/60 group-hover:border-[#D12636] transition-colors duration-300 pointer-events-none"></div>
        <div class="absolute top-0 right-0 w-3 h-3 border-t-2 border-r-2 border-[#681826]/60 group-hover:border-[#D12636] transition-colors duration-300 pointer-events-none"></div>
        <div class="absolute bottom-0 left-0 w-3 h-3 border-b-2 border-l-2 border-[#681826]/60 group-hover:border-[#D12636] transition-colors duration-300 pointer-events-none"></div>
        <div class="absolute bottom-0 right-0 w-3 h-3 border-b-2 border-r-2 border-[#681826]/60 group-hover:border-[#D12636] transition-colors duration-300 pointer-events-none"></div>

        <!-- Top Glow -->
        <div class="absolute top-0 left-0 right-0 h-[1px] bg-gradient-to-r from-transparent via-[#681826] to-transparent opacity-50 group-hover:opacity-100 transition-opacity"></div>
        <div class="absolute -right-16 -top-16 w-36 h-36 bg-[#681826]/10 rounded-full blur-2xl group-hover:bg-[#681826]/20 transition-all duration-500 pointer-events-none"></div>

        <!-- Card Header -->
        <div class="mb-6 relative z-10">
          <div class="flex items-center justify-between gap-2 mb-2">
            <div class="flex items-center gap-2">
              <span class="font-mono text-[10px] font-bold text-[#D12636] bg-[#681826]/20 border border-[#681826]/40 px-2 py-0.5 rounded-xs tracking-wider">
                {group.id}
              </span>
              <span class="font-mono text-[11px] text-white/40 tracking-wider">
                //{group.codename}
              </span>
            </div>
            <span class="font-mono text-[10px] text-[#E0D5C9]/50 tracking-widest uppercase">
              {group.badge}
            </span>
          </div>

          <h3 class="text-xl md:text-2xl font-bold text-white tracking-tight group-hover:text-[#E0D5C9] transition-colors flex items-center gap-2">
            {group.category}
          </h3>
          <p class="text-xs text-white/50 font-mono mt-1 leading-relaxed">
            {group.description}
          </p>
        </div>

        <!-- Interactive Tactical Tech Modules -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 relative z-10">
          {group.items.map((tech) => (
            <div 
              class="tech-item relative flex items-center justify-between p-3 bg-white/[0.02] hover:bg-[#681826]/20 border border-white/5 hover:border-[#681826]/70 rounded-xs transition-all duration-300 cursor-pointer select-none group/item active:scale-[0.98]"
              data-tech={tech.name}
              data-icon={getIcon(tech.name)}
              role="button"
              tabindex="0"
              aria-label={`Deploy ${tech.name} module`}
            >
              <!-- Hover Accent Line -->
              <div class="absolute left-0 top-0 bottom-0 w-[2px] bg-[#681826] opacity-0 group-hover/item:opacity-100 group-hover/item:bg-[#D12636] transition-all duration-300"></div>

              <div class="flex items-center gap-3 min-w-0">
                <div class="w-8 h-8 rounded-xs bg-[#0F0F11] border border-white/10 group-hover/item:border-[#681826]/60 flex items-center justify-center p-1.5 transition-colors shrink-0 shadow-inner">
                  <img 
                    src={getIcon(tech.name)} 
                    alt={tech.name} 
                    class="w-4 h-4 opacity-70 group-hover/item:opacity-100 group-hover/item:scale-110 transition-all duration-300"
                    loading="lazy"
                  />
                </div>
                
                <div class="min-w-0">
                  <div class="flex items-center gap-2">
                    <span class="font-mono text-xs font-bold text-white tracking-wide group-hover/item:text-[#E0D5C9] truncate">
                      {tech.name}
                    </span>
                  </div>
                  <span class="block font-mono text-[10px] text-white/40 group-hover/item:text-white/60 truncate">
                    {tech.role}
                  </span>
                </div>
              </div>

              <!-- Module Status & Trigger Indicator -->
              <div class="flex items-center gap-1.5 shrink-0 pl-2">
                <span class="font-mono text-[9px] text-[#681826] group-hover/item:text-[#D12636] opacity-80 group-hover/item:opacity-100 uppercase tracking-wider hidden sm:inline">
                  [{tech.status || "ARMED"}]
                </span>
                <div class="w-1.5 h-1.5 rounded-full bg-[#681826] group-hover/item:bg-[#D12636] group-hover/item:shadow-[0_0_6px_#D12636] transition-all"></div>
              </div>
            </div>
          ))}
        </div>

        <!-- Tactical Card Footer Telemetry -->
        <div class="mt-5 pt-3 border-t border-white/5 flex items-center justify-between text-[10px] font-mono text-white/30">
          <span>PORT: 0x{group.id.slice(-2)}F</span>
          <span class="flex items-center gap-1">
            <span class="inline-block w-1 h-1 bg-[#681826] rounded-full"></span>
            SYS_LINK_READY
          </span>
        </div>

      </div>
    ))}
  </div>

  <!-- Rain Protocol Canvas Container -->
  <div id="rain-container" class="fixed inset-0 pointer-events-none z-[40]"></div>
</section>

<script>
  import { gsap } from "gsap";

  function initTechArsenal() {
    const container = document.getElementById('rain-container');
    const items = document.querySelectorAll('.tech-item');
    let audioCtx: AudioContext | null = null;

    const playTacticalClick = () => {
      try {
        if (!audioCtx) {
          audioCtx = new (window.AudioContext || (window as any).webkitAudioContext)();
        }
        if (audioCtx.state === 'suspended') {
          audioCtx.resume();
        }
        
        const masterGain = audioCtx.createGain();
        masterGain.connect(audioCtx.destination);
        masterGain.gain.setValueAtTime(0.12, audioCtx.currentTime);

        const osc1 = audioCtx.createOscillator();
        osc1.type = 'square';
        osc1.frequency.setValueAtTime(1200, audioCtx.currentTime);
        osc1.frequency.exponentialRampToValueAtTime(50, audioCtx.currentTime + 0.1);
        
        const osc2 = audioCtx.createOscillator();
        osc2.type = 'sawtooth';
        osc2.frequency.setValueAtTime(160, audioCtx.currentTime);
        osc2.frequency.linearRampToValueAtTime(35, audioCtx.currentTime + 0.1);

        const clickGain = audioCtx.createGain();
        clickGain.gain.setValueAtTime(0.18, audioCtx.currentTime);
        clickGain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + 0.15);

        osc1.connect(clickGain);
        osc2.connect(clickGain);
        clickGain.connect(masterGain);

        osc1.start();
        osc2.start();
        osc1.stop(audioCtx.currentTime + 0.15);
        osc2.stop(audioCtx.currentTime + 0.15);
      } catch (err) {
        console.warn('Tactical audio error:', err);
      }
    };

    const handleItemClick = (e: Event) => {
      const target = e.currentTarget as HTMLElement;
      const iconUrl = target.dataset.icon;
      if (!iconUrl || !container) return;

      playTacticalClick();

      gsap.fromTo(target, 
        { scale: 0.96 }, 
        { scale: 1, duration: 0.25, ease: "back.out(2)" }
      );

      const particleCount = 22;
      for (let i = 0; i < particleCount; i++) {
        const drop = document.createElement('img');
        drop.src = iconUrl;
        drop.classList.add('absolute', 'w-6', 'h-6', 'opacity-85', 'pointer-events-none', 'filter', 'drop-shadow-[0_0_8px_rgba(104,24,38,0.8)]');
        
        const startX = Math.random() * window.innerWidth;
        const startY = -50 - (Math.random() * 250);
        
        drop.style.left = `${startX}px`;
        drop.style.top = `${startY}px`;
        container.appendChild(drop);

        gsap.to(drop, {
          y: window.innerHeight + 250,
          rotation: Math.random() * 720 - 360,
          duration: 1.2 + Math.random() * 2.2,
          ease: "power1.in",
          onComplete: () => drop.remove()
        });
      }
    };

    items.forEach(item => {
      item.removeEventListener('click', handleItemClick);
      item.addEventListener('click', handleItemClick);
      item.addEventListener('keydown', (e: Event) => {
        const keyEvent = e as KeyboardEvent;
        if (keyEvent.key === 'Enter' || keyEvent.key === ' ') {
          keyEvent.preventDefault();
          handleItemClick(e);
        }
      });
    });
  }

  initTechArsenal();
  document.addEventListener('astro:page-load', initTechArsenal);
</script>
