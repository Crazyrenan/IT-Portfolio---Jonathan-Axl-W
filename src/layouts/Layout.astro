---
import '@fontsource/space-grotesk';
import '@fontsource/jetbrains-mono';
import { ClientRouter } from 'astro:transitions';
import SpyCursor from '../components/SpyCursor';
import Navbar from '../components/Navbar.astro';
import ThemeToggle from '../components/ThemeToggle.astro';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="Jonathan Axl Wibowo - Full Stack Engineer" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <ClientRouter />

  <script is:inline>
    (function() {
      const savedTheme = localStorage.getItem('theme');
      // If it's dark OR if there is no saved theme yet, add the dark class
      if (savedTheme === 'dark' || !savedTheme) {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }
    })();
  </script>
  </head>

  <body class="bg-background text-text font-sans antialiased min-h-screen flex flex-col overflow-x-hidden transition-colors duration-500">
    <SpyCursor client:load /> 
    <ThemeToggle />
    <Navbar />
    <main class="flex-grow flex flex-col relative w-full">
      <slot />
    </main>
  </body>
</html>