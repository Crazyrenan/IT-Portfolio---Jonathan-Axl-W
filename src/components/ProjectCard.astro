---
interface Props {
  title: string;
  excerpt: string;
  date: string;
  href: string;
}

const { title, excerpt, date, href } = Astro.props;
---

<a href={href} class="group block relative">
  <div class="h-full bg-surface border border-white/5 p-6 rounded-sm transition-all duration-300 group-hover:border-primary/50 group-hover:translate-y-[-2px]">
    
    <div class="mb-4">
      <span class="text-xs font-mono text-white/40 uppercase tracking-widest border border-white/10 px-2 py-1 rounded-sm">
        {date}
      </span>
    </div>

    <h3 class="text-xl font-bold text-white mb-2 group-hover:text-primary transition-colors">
      {title}
    </h3>

    <p class="text-neutral/70 leading-relaxed font-mono text-sm">
      {excerpt}
    </p>

    <div class="absolute top-0 right-0 p-2 opacity-0 group-hover:opacity-100 transition-opacity">
      <div class="w-2 h-2 bg-primary"></div>
    </div>
  </div>
</a>