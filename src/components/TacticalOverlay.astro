---
// TacticalOverlay.astro
// Concept: "Silent Scope" - Minimalist Framing
---

<div class="fixed inset-0 z-[40] pointer-events-none select-none overflow-hidden">
  
  <div class="absolute inset-0 bg-[linear-gradient(rgba(18,16,19,0)_50%,rgba(0,0,0,0.05)_50%),linear-gradient(90deg,rgba(255,0,0,0.03),rgba(0,255,0,0.01),rgba(0,0,255,0.03))] z-0 bg-[length:100%_4px,6px_100%]"></div>

  <div class="absolute top-6 left-6 w-8 h-8 border-l border-t border-primary/40"></div>
  <div class="absolute top-6 right-6 w-8 h-8 border-r border-t border-primary/40"></div>
  <div class="absolute bottom-6 left-6 w-8 h-8 border-l border-b border-primary/40"></div>
  <div class="absolute bottom-6 right-6 w-8 h-8 border-r border-b border-primary/40"></div>

  <div class="absolute top-8 left-10 flex items-center gap-2 opacity-50">
    <div class="w-1 h-1 bg-primary rounded-full animate-pulse"></div>
    <span class="font-mono text-[10px] tracking-[0.2em] text-primary">REC</span>
  </div>

  <div class="absolute bottom-8 right-10 opacity-30">
    <span class="font-mono text-[10px] tracking-widest text-text">SYS.NORMAL</span>
  </div>

  <div class="absolute top-1/2 left-6 -translate-y-1/2 flex flex-col gap-8 opacity-20 hidden md:flex">
    <div class="w-px h-2 bg-primary"></div>
    <div class="w-px h-2 bg-primary"></div>
    <div class="w-px h-2 bg-primary"></div>
  </div>

  <div class="absolute top-1/2 right-6 -translate-y-1/2 flex flex-col gap-8 opacity-20 hidden md:flex">
    <div class="w-px h-2 bg-primary"></div>
    <div class="w-px h-2 bg-primary"></div>
    <div class="w-px h-2 bg-primary"></div>
  </div>

</div>