---
import { navLinks } from '../config/site';

const visibleLinks = navLinks.filter(link => link.active);
---

<nav class="fixed top-0 left-0 right-0 z-50 px-6 py-4">
  <div class="max-w-6xl mx-auto">
    <div class="flex items-center justify-between p-4 bg-surface/90 backdrop-blur-md border border-primary/10 rounded-sm shadow-2xl transition-colors duration-500">
      
      <a href="/" class="text-xl font-bold text-text tracking-tighter hover:text-primary transition-colors">
        JAWS<span class="text-primary">.</span>SYS
      </a>

      <div class="hidden md:flex items-center gap-2 ml-4 px-3 py-1 bg-background/50 border border-primary/10 rounded-sm transition-colors duration-500">
            <span class="text-[10px] text-text/50 font-mono">VITALS</span>
            <svg width="50" height="20" viewBox="0 0 100 40" class="text-green-500">
                <path 
                d="M0 20 H30 L40 5 L50 35 L60 20 H100" 
                fill="none" 
                stroke="currentColor" 
                stroke-width="2" 
                stroke-linecap="round" 
                stroke-linejoin="round"
                class="animate-pulse-fast" 
                />
            </svg>
            <span class="text-[10px] text-green-500 font-mono tracking-widest">FINE</span>
      </div>

      <div class="hidden md:flex items-center space-x-8">
        {visibleLinks.map((link) => (
          /* CHANGED:
             - text-neutral/70 -> text-text/70
             - hover:text-white -> hover:text-primary 
          */
          <a 
            href={link.href} 
            class="text-sm font-mono text-text/70 hover:text-primary hover:tracking-widest transition-all duration-300 uppercase"
          >
            {link.name}
          </a>
        ))}
        
      </div>
        
        <button id="menu-btn" class="text-text focus:outline-none md:hidden">
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7" />
          </svg>
        </button>
      </div>

    </div>

    <div id="mobile-menu" class="hidden md:hidden absolute top-20 left-6 right-6 bg-surface border border-primary/10 p-6 flex-col space-y-4 rounded-sm shadow-xl z-50 transition-colors duration-500">
      {visibleLinks.map((link) => (
        /* CHANGED:
           - text-neutral/70 -> text-text/70
           - hover:text-white -> hover:text-primary
           - border-white/5 -> border-primary/5
        */
        <a 
          href={link.href} 
          class="block text-center font-mono text-text/70 hover:text-primary py-2 border-b border-primary/5 last:border-0 transition-colors"
        >
          {link.name}
        </a>
      ))}
    </div>
  </div>
</nav>

<script>
  const btn = document.getElementById('menu-btn');
  const menu = document.getElementById('mobile-menu');

  btn?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
    menu?.classList.toggle('flex');
  });
</script>

<style>
  @keyframes pulse-fast {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.5; }
  }
  .animate-pulse-fast {
    animation: pulse-fast 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
  }
</style>