---
import '@fontsource/space-grotesk';
import '@fontsource/jetbrains-mono';
import { ClientRouter } from 'astro:transitions';

import { FloatingRetroBackground } from '../components/retro/FloatingRetroBackground';

// Import Global Styles
import '../styles/global.css'; 

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="Jonathan Axl Wibowo - Full Stack Engineer" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <ClientRouter />
  </head>

  <body class="font-sans antialiased min-h-screen overflow-x-hidden relative selection:bg-[#FFEA00] selection:text-black">
    
    <!-- Floating Background Layer -->
    <FloatingRetroBackground client:idle />

    <!-- CRT Scanlines Overlay -->
    <div class="crt-scanlines"></div>

    <div id="site-wrapper" class="relative z-10 flex flex-col min-h-screen opacity-0 transition-opacity duration-300"> 
      <main class="flex-grow flex flex-col relative w-full pt-4">
        <slot />
      </main>
    </div>

    <script>
      function revealSite() {
        const wrapper = document.getElementById('site-wrapper');
        if (!wrapper) return;
        requestAnimationFrame(() => {
          wrapper.style.opacity = "1";
        });
      }

      revealSite();
      
      document.addEventListener('astro:after-swap', () => {
        const wrapper = document.getElementById('site-wrapper');
        if (wrapper) {
          wrapper.style.opacity = "0"; 
          setTimeout(revealSite, 10); 
        }
      });
    </script>
  </body>
</html>
