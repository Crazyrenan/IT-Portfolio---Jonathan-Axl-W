---
import { navLinks } from '../config/site';

const visibleLinks = navLinks.filter(link => link.active);
---

<nav class="fixed top-0 left-0 right-0 z-50 px-6 py-4">
  <div class="max-w-6xl mx-auto">
    <div class="flex items-center justify-between p-4 bg-[#1B1B1E]/85 backdrop-blur-xl border border-[#681826]/40 rounded-xs shadow-[0_10px_30px_rgba(0,0,0,0.5)] transition-colors duration-500">
      
      <a href="/" class="text-xl font-bold text-[#E0D5C9] tracking-tighter hover:text-[#D12636] transition-colors flex items-center gap-1">
        JAWS<span class="text-[#D12636]">.</span>SYS
      </a>

      <div class="hidden md:flex items-center gap-2 ml-4 px-3 py-1 bg-[#0F0F11] border border-[#681826]/30 rounded-xs transition-colors duration-500">
        <span class="text-[10px] text-[#E0D5C9]/50 font-mono tracking-widest">VITALS</span>
        <svg width="50" height="20" viewBox="0 0 100 40" class="text-[#D12636]">
          <path 
            d="M0 20 H30 L40 5 L50 35 L60 20 H100" 
            fill="none" 
            stroke="currentColor" 
            stroke-width="2" 
            stroke-linecap="round" 
            stroke-linejoin="round"
            class="animate-pulse-fast" 
          />
        </svg>
        <span class="text-[10px] text-[#D12636] font-mono tracking-widest font-bold">ARMED</span>
      </div>

      <div class="hidden md:flex items-center space-x-8">
        {visibleLinks.map((link) => (
          <a 
            href={link.href} 
            class="text-sm font-mono text-[#E0D5C9]/70 hover:text-[#D12636] hover:tracking-widest transition-all duration-300 uppercase"
          >
            {link.name}
          </a>
        ))}
      </div>
        
      <button id="menu-btn" class="text-[#E0D5C9] hover:text-[#D12636] focus:outline-none md:hidden" aria-label="Toggle Navigation Menu">
        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7" />
        </svg>
      </button>

    </div>

    <div id="mobile-menu" class="hidden md:hidden absolute top-20 left-6 right-6 bg-[#1B1B1E]/95 backdrop-blur-2xl border border-[#681826]/50 p-6 flex-col space-y-4 rounded-xs shadow-2xl z-50 transition-colors duration-500">
      {visibleLinks.map((link) => (
        <a 
          href={link.href} 
          class="block text-center font-mono text-[#E0D5C9]/80 hover:text-[#D12636] py-2 border-b border-[#681826]/20 last:border-0 transition-colors tracking-wider"
        >
          {link.name}
        </a>
      ))}
    </div>
  </div>
</nav>

<script>
  const btn = document.getElementById('menu-btn');
  const menu = document.getElementById('mobile-menu');

  btn?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
    menu?.classList.toggle('flex');
  });
</script>

<style>
  @keyframes pulse-fast {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.5; }
  }
  .animate-pulse-fast {
    animation: pulse-fast 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
  }
</style>