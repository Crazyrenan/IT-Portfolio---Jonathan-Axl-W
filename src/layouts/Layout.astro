---
import '@fontsource/space-grotesk';
import '@fontsource/jetbrains-mono';
import { ClientRouter } from 'astro:transitions';
import SpyCursor from '../components/SpyCursor';
import Navbar from '../components/Navbar.astro';
import TacticalOverlay from '../components/TacticalOverlay.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import '../styles/global.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="Jonathan Axl Wibowo - Full Stack Engineer" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <ClientRouter />

    <script is:inline>
      (function() {
        const savedTheme = localStorage.getItem('theme');
        if (savedTheme === 'light') {
          document.documentElement.classList.remove('dark');
        } else {
          document.documentElement.classList.add('dark');
        }
      })();
    </script>
  </head>

  <body class="bg-background text-text font-sans antialiased min-h-screen overflow-x-hidden relative">
    
    <div class="fixed inset-0 z-[50] pointer-events-none">
        <TacticalOverlay /> 
    </div>

    <div class="fixed inset-0 z-[60] pointer-events-none">
        <SpyCursor client:load /> 
    </div>

    <div id="site-wrapper" style="opacity: 0;"> 
      <ThemeToggle />
      <Navbar />
      <main class="flex-grow flex flex-col relative w-full">
        <slot />
      </main>
    </div>

    <script>
      function revealSite() {
        const wrapper = document.getElementById('site-wrapper');
        if (!wrapper) return;
        wrapper.style.opacity = "0";
        setTimeout(() => {
          wrapper.style.transition = "opacity 1.2s ease-in-out";
          wrapper.style.opacity = "1";
        }, 500); // Reduced time for faster feedback
      }

      revealSite();
      document.addEventListener('astro:after-swap', revealSite);
    </script>
  </body>
</html>