---
import Layout from '../layouts/Layout.astro';
import Hero3D from '../components/Hero3D';
import Manifesto from '../components/Manifesto.astro';
import TechArsenal from '../components/TechArsenal.astro';
import MissionLog from '../components/Missionlog.astro';
import About from '../components/About.astro';
import ContactTerminal from '../components/ContactTerminal.astro';
---

<Layout title="Jonathan Axl Wibowo | Full Stack Engineer">
  
  <main class="relative w-full overflow-hidden">
    
    <section id="hero" class="relative h-screen w-full flex items-center justify-center overflow-hidden">
      
      <div class="absolute inset-0 z-0 opacity-60">
        <Hero3D client:load />
      </div>

      <div class="relative z-10 text-center px-4">
        <div class="inline-block mb-4 px-3 py-1 border border-primary/20 bg-surface/50 backdrop-blur-sm rounded-full">
          <span class="font-mono text-primary text-xs tracking-[0.2em] uppercase">
            // System Online
          </span>
        </div>
        
        <h1 class="text-5xl md:text-8xl font-bold tracking-tighter mb-6 text-text">
          Jonathan <br class="md:hidden" />
          <span class="text-primary">Axl Wibowo</span>
        </h1>

        <p class="text-lg md:text-xl font-mono text-text/60 max-w-2xl mx-auto leading-relaxed">
          Full-Stack Engineering <span class="text-primary">×</span> Intelligent Data
        </p>
      </div>

      <div class="absolute bottom-0 left-0 w-full h-32 bg-gradient-to-t from-background to-transparent z-20 pointer-events-none"></div>
    
    </section>

    <div class="relative z-10 bg-background">
      <Manifesto />
      <About />
      <TechArsenal />
      <MissionLog />
      <ContactTerminal />
    </div>

  </main>
</Layout>