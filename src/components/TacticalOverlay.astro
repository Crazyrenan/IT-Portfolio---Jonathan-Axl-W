---
// src/components/TacticalOverlay.astro
---
<div id="tactical-wipe" class="fixed inset-0 z-[10000] flex flex-col overflow-hidden pointer-events-auto bg-background">
  <div class="wipe-panel bg-primary/10 w-full h-1/4"></div>
  <div class="wipe-panel bg-primary/30 w-full h-1/4"></div>
  <div class="wipe-panel bg-primary/60 w-full h-1/4"></div>
  <div class="wipe-panel bg-background w-full h-1/4 border-t border-primary/20"></div>
  
  <div id="welcome-content" class="absolute inset-0 flex items-center justify-center z-[10001] opacity-0">
    <div class="text-center px-4">
      <div class="mb-6 flex justify-center">
        <div class="w-24 h-24 text-primary">
          <svg viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 2L4.5 20.29L5.21 21L12 18L18.79 21L19.5 20.29L12 2Z" />
          </svg>
        </div>
      </div>
      <h2 class="text-primary font-mono text-xs tracking-[0.5em] uppercase mb-2 animate-pulse">// INITIALIZING NEURAL LINK</h2>
      <h1 class="text-4xl md:text-7xl font-bold text-text uppercase tracking-tighter">
        Jonathan <span class="text-primary">Axl</span>
      </h1>
      <p class="text-text/40 font-mono text-[10px] mt-4 uppercase tracking-[0.3em]">Umbrella Corp / Neural Link Established</p>
    </div>
  </div>
</div>

<script>
  import { gsap } from 'gsap';

  function runTacticalWipe() {
    const overlay = document.getElementById('tactical-wipe');
    const panels = document.querySelectorAll('.wipe-panel');
    const content = document.getElementById('welcome-content');
    const siteWrapper = document.getElementById('site-wrapper');

    if (!overlay || !siteWrapper) return;

    // Reset awal
    gsap.set(overlay, { display: 'flex', opacity: 1, pointerEvents: 'auto' });
    gsap.set(panels, { xPercent: 0 });
    gsap.set(siteWrapper, { opacity: 0, scale: 0.98 });

    const tl = gsap.timeline({
      onComplete: () => {
        gsap.set(overlay, { display: 'none', pointerEvents: 'none' });
      }
    });

    // 1. Tampilkan Teks Welcome (Lama: 2 detik total)
    tl.to(content, { 
      opacity: 1, 
      duration: 0.8, 
      ease: "power2.out" 
    })
    .to(content, { 
      opacity: 0, 
      duration: 0.4, 
      delay: 1.5, // Memberikan waktu user membaca teks
      ease: "power2.in" 
    });

    // 2. Transisi "Wipe" dan "Reveal" Site
    // Kita jalankan SETELAH teks benar-benar hilang agar tidak tabrakan
    tl.to(panels, {
      xPercent: -100,
      duration: 1.2,
      stagger: 0.1,
      ease: "expo.inOut"
    }) 
    .to(siteWrapper, {
      opacity: 1,
      scale: 1,
      duration: 1,
      ease: "power2.out"
    }, "-=0.8"); // Site mulai muncul saat panel hampir selesai bergeser
  }

  runTacticalWipe();
  document.addEventListener('astro:after-swap', runTacticalWipe);
</script>