---
import Layout from '../layouts/Layout.astro';
import { PixelHero } from '../components/retro/PixelHero';
import { RetroSkillsGrid } from '../components/retro/RetroSkillsGrid';
import { RetroProjectsDossier } from '../components/retro/RetroProjectsDossier';
import { RetroTimeline } from '../components/retro/RetroTimeline';
import { RetroTerminal } from '../components/retro/RetroTerminal';
import RetroTaskbar from '../components/retro/RetroTaskbar.astro';
---

<Layout title="Jonathan Axl Wibowo | Full Stack Engineer">
  <main class="relative w-full overflow-hidden pb-16">

    <!-- ── Phase 1: 8-Bit Hero Stage ── -->
    <div id="hero" class="scroll-mt-20">
      <PixelHero client:load />
    </div>

    <!-- ── Sprint 2: 8-Bit Skills Matrix & Retro Projects Dossier ── -->
    <div class="relative z-30 w-full flex flex-col items-center -mt-8 md:-mt-16">
      <div id="skills" class="w-full scroll-mt-20">
        <RetroSkillsGrid client:load />
      </div>
      <div id="projects" class="w-full scroll-mt-20">
        <RetroProjectsDossier client:load />
      </div>
    </div>

    <!-- ── Sprint 3: Experience Quest Log & Contact Console ── -->
    <div class="relative z-30 w-full flex flex-col items-center mt-8">
      <div id="experience" class="w-full scroll-mt-20">
        <RetroTimeline client:visible />
      </div>
      <div id="contact" class="w-full scroll-mt-20">
        <RetroTerminal client:visible />
      </div>
    </div>

  </main>
  
  <RetroTaskbar />
</Layout>
