---
import { getCollection } from 'astro:content';

// Fetch all projects, sort newest first, take top 3 for homepage grid
const allProjects = await getCollection('projects');
const featured = allProjects
  .sort((a, b) => {
    const da = a.data.date ? new Date(a.data.date).valueOf() : 0;
    const db = b.data.date ? new Date(b.data.date).valueOf() : 0;
    return db - da;
  })
  .slice(0, 3);

// Map a project slug to a short dossier codename
const codenames: Record<string, string> = {
  'tb-detection-comparative-study': 'NEURAL_SIGHT',
  'lkh-internal-platform':          'FIELD_OPS',
  'imip-recruitment':               'TALENT_SCAN',
  'optical-intel-ocr':              'OPTICAL_INTEL',
  'help-desk-ai':                   'SUPPORT_AI',
  'field-service-pro':              'SVC_PRO',
};

// Map a project slug to a one-line metric summary
const metrics: Record<string, string> = {
  'tb-detection-comparative-study': '97% accuracy · IEEE YESIST12 · Grad-CAM',
  'lkh-internal-platform':          'SHA-256 blockchain · RBAC · FastAPI',
  'imip-recruitment':               'AI screening · 40% faster queries · RBAC',
  'optical-intel-ocr':              'OCR pipeline · Python · OpenCV',
  'help-desk-ai':                   'GPT integration · Laravel · real-time',
  'field-service-pro':              'React Native · offline-first · GPS',
};
---

<section id="case-studies" class="py-24 px-6 relative z-10 overflow-hidden">

  <!-- Ambient glow -->
  <div class="absolute top-0 right-0 w-[500px] h-[400px] bg-primary/5 blur-[140px] rounded-full pointer-events-none" aria-hidden="true"></div>

  <div class="max-w-6xl mx-auto">

    <!-- Section header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-14 border-b border-primary/20 pb-6">
      <div>
        <div class="flex items-center gap-2 mb-3">
          <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 bg-primary/10 border border-primary/40 font-mono text-[11px] tracking-[0.2em] text-primary-glow uppercase">
            <span class="w-1.5 h-1.5 rounded-full bg-primary-glow animate-pulse"></span>
            CLASSIFIED // CASE_FILES
          </span>
        </div>
        <h2 class="text-3xl md:text-5xl font-bold text-text tracking-tight">
          Selected <span class="text-primary-glow">Case Studies</span>
        </h2>
      </div>
      <div class="font-mono text-xs text-text/30 flex flex-col items-start md:items-end gap-1">
        <span>DOSSIERS: {featured.length.toString().padStart(2, '0')} / {allProjects.length.toString().padStart(2, '0')}</span>
        <span class="text-text/20">CLEARANCE: LEVEL 04</span>
      </div>
    </div>

    <!-- Dossier card grid -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-5 mb-8">
      {featured.map((project, index) => {
        const codename = codenames[project.slug] ?? `OP_${String(index + 1).padStart(2, '0')}`;
        const metric   = metrics[project.slug]   ?? 'Classified performance metrics.';
        return (
          <article
            class="group relative flex flex-col bg-surface/60 backdrop-blur-md border border-primary/20 hover:border-[rgba(255,102,0,0.45)] transition-all duration-400 overflow-hidden"
            style="transition: border-color 0.3s ease, box-shadow 0.3s ease;"
            onmouseover="this.style.boxShadow='0 0 28px rgba(255,102,0,0.08), inset 0 0 0 1px rgba(255,102,0,0.25)'; this.style.borderColor='rgba(255,102,0,0.4)';"
            onmouseout="this.style.boxShadow=''; this.style.borderColor='';"
          >
            <!-- HUD corner brackets -->
            <div class="absolute top-0 left-0 w-4 h-4 border-t-2 border-l-2 border-primary/40 group-hover:border-[rgba(255,102,0,0.6)] transition-colors duration-300 pointer-events-none"></div>
            <div class="absolute top-0 right-0 w-4 h-4 border-t-2 border-r-2 border-primary/40 group-hover:border-[rgba(255,102,0,0.6)] transition-colors duration-300 pointer-events-none"></div>
            <div class="absolute bottom-0 left-0 w-4 h-4 border-b-2 border-l-2 border-primary/40 group-hover:border-[rgba(255,102,0,0.6)] transition-colors duration-300 pointer-events-none"></div>
            <div class="absolute bottom-0 right-0 w-4 h-4 border-b-2 border-r-2 border-primary/40 group-hover:border-[rgba(255,102,0,0.6)] transition-colors duration-300 pointer-events-none"></div>

            <!-- Card top bar -->
            <div class="flex items-center justify-between px-5 py-3 border-b border-primary/10">
              <span class="font-mono text-[10px] text-primary-glow bg-primary/15 border border-primary/30 px-2 py-0.5 tracking-widest uppercase">
                {String(index + 1).padStart(2, '0')} // {codename}
              </span>
              <span class="font-mono text-[10px] text-text/25 tracking-widest">DOSSIER</span>
            </div>

            <!-- Card body -->
            <div class="flex-1 p-5 flex flex-col gap-4">

              <!-- Project title -->
              <h3 class="text-base md:text-lg font-bold text-text leading-snug group-hover:text-white transition-colors duration-200">
                {project.data.title}
              </h3>

              <!-- Excerpt -->
              <p class="font-mono text-xs text-text/50 leading-relaxed line-clamp-3 flex-1">
                {project.data.excerpt ?? 'Classified project specifications — access restricted.'}
              </p>

              <!-- Metric badge -->
              <div class="flex items-center gap-2 py-2 border-t border-primary/10">
                <span class="w-1.5 h-1.5 rounded-full bg-[rgba(255,102,0,0.8)] shrink-0"></span>
                <span class="font-mono text-[10px] text-[rgba(255,102,0,0.75)] tracking-wide truncate">{metric}</span>
              </div>

              <!-- Tags -->
              <div class="flex flex-wrap gap-1.5">
                {(project.data.tags ?? []).slice(0, 4).map(tag => (
                  <span class="font-mono text-[10px] px-2 py-0.5 border border-primary/25 text-text/40 bg-primary/5 uppercase tracking-wide">
                    {tag}
                  </span>
                ))}
              </div>
            </div>

            <!-- Card footer -->
            <div class="px-5 pb-5 pt-3 border-t border-primary/10 flex items-center justify-between gap-3">
              <a
                href={`/projects/${project.slug}`}
                class="inline-flex items-center gap-1.5 font-mono text-[11px] text-text/50 hover:text-[rgba(255,102,0,0.9)] transition-colors duration-200 tracking-widest uppercase"
              >
                <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M5 12h14M12 5l7 7-7 7"/>
                </svg>
                Access Log
              </a>

              {project.data.githubUrl && (
                <a
                  href={project.data.githubUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1.5 font-mono text-[11px] text-text/30 hover:text-text/70 transition-colors duration-200 tracking-widest uppercase"
                  aria-label={`View ${project.data.title} on GitHub`}
                >
                  <svg width="10" height="10" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.929.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/>
                  </svg>
                  Repo
                </a>
              )}
            </div>

          </article>
        );
      })}
    </div>

    <!-- View all link -->
    <div class="flex justify-end">
      <a
        href="#works"
        class="inline-flex items-center gap-2 font-mono text-xs text-text/40 hover:text-[rgba(255,102,0,0.8)] transition-colors duration-200 tracking-widest uppercase border-b border-transparent hover:border-[rgba(255,102,0,0.3)] pb-0.5"
      >
        VIEW ALL {allProjects.length} DOSSIERS
        <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
      </a>
    </div>

  </div>
</section>
