---
import { getCollection } from 'astro:content';
import ProjectCard from './ProjectCard.astro';

// 1. Fetch & Sort Projects (Keep existing logic)
const projects = await getCollection('projects');

const sortedProjects = projects.sort((a, b) => {
  const dateA = new Date(a.data.date || 0).valueOf();
  const dateB = new Date(b.data.date || 0).valueOf();
  return dateB - dateA;
});
---

<section id="mission-log" class="relative py-24 px-6 max-w-7xl mx-auto overflow-hidden">
  
  <div class="mb-16 border-l-2 border-primary/30 pl-6 ml-4 md:ml-0">
    <span class="font-mono text-primary text-xs tracking-[0.3em] uppercase block mb-2">
      // Operational History
    </span>
    <h2 class="text-4xl md:text-5xl font-bold text-text tracking-tighter uppercase">
      Mission <span class="text-primary">Log</span>
    </h2>
    <p class="mt-4 text-text/60 font-mono text-xs md:text-sm max-w-xl">
      [RESTRICTED ACCESS] Selected case files from active deployment. 
      Interact with dossiers to view full mission reports.
    </p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 relative z-10">
  {sortedProjects.map((project) => (
    <div class="project-card-wrapper opacity-0"> 
      <ProjectCard 
        client:visible 
        title={project.data.title}     
        tagline={project.data.excerpt || "Classified project details."} 
        image={project.data.coverImage || "/images/placeholder.jpg"} 
        slug={project.slug} 
        techStack={project.data.tags || []} 
      />
    </div>
  ))}
</div>

  <div class="absolute top-20 right-0 w-96 h-96 bg-primary/5 blur-[120px] pointer-events-none -z-10"></div>

</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  // Animate the Grid with a Stagger Effect
  // This looks like files being placed on a desk one by one
  gsap.to(".project-card-wrapper", {
    opacity: 1,
    y: 0,
    duration: 0.8,
    stagger: 0.15, // Delay between each card appearing
    ease: "power2.out",
    scrollTrigger: {
      trigger: "#mission-log",
      start: "top 70%", // Start animation when section is 70% down viewport
    }
  });

  // Set initial state via GSAP to ensure no flash of unstyled content
  gsap.set(".project-card-wrapper", { y: 50, opacity: 0 });
</script>