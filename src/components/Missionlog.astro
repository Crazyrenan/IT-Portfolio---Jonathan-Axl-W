---
import { getCollection } from 'astro:content';

// 1. Fetch & Sort Projects
const projects = await getCollection('projects');

const sortedProjects = projects.sort((a, b) => {
  const dateA = new Date(a.data.date || 0).valueOf();
  const dateB = new Date(b.data.date || 0).valueOf();
  return dateB - dateA;
});
---

<section id="mission-log" class="relative min-h-screen py-20 px-4 max-w-6xl mx-auto">
  
  <div class="mb-20 pl-12 md:pl-0">
    <span class="font-mono text-primary text-xs tracking-widest uppercase block mb-2">
      // ARCHIVE ACCESS
    </span>
    <h2 class="text-4xl md:text-5xl font-bold text-text">
      Mission Log
    </h2>
  </div>

  <div class="relative">
    <div class="absolute left-4 md:left-1/2 top-0 bottom-0 w-px bg-white/10 -translate-x-1/2"></div>
    
    <div id="progress-line" class="absolute left-4 md:left-1/2 top-0 w-px bg-primary -translate-x-1/2 h-0"></div>

    <div class="space-y-24">
      {sortedProjects.map((project, index) => (
        <div class={`project-node relative flex flex-col md:flex-row gap-8 md:gap-20 items-center ${index % 2 === 0 ? 'md:flex-row-reverse' : ''}`}>
          
          <div class="absolute left-4 md:left-1/2 w-3 h-3 bg-surface border border-primary rounded-full -translate-x-1/2 z-10 mt-6 md:mt-0"></div>

          <div class="w-full md:w-1/2 pl-12 md:pl-0">
            <a href={`/projects/${project.slug}`} class="group block space-y-4">
              
              <span class="inline-block px-2 py-1 bg-white/5 border border-white/10 rounded-sm text-xs font-mono text-primary">
                {new Date(project.data.date || Date.now()).toISOString().split('T')[0]}
              </span>

              <h3 class="text-3xl font-bold text-text group-hover:text-primary transition-colors">
                {project.data.title}
              </h3>

              <p class="text-neutral/70 leading-relaxed max-w-md mb-4 group-hover:text-text transition-colors duration-500">
                {project.data.excerpt}
              </p>

              {project.data.tags && project.data.tags.length > 0 && (
                <div class="flex flex-wrap gap-2 mb-6">
                  {project.data.tags.map((tag: string) => (
                    <span class="px-2 py-1 text-[10px] font-mono uppercase tracking-wider text-primary border border-primary/20 bg-primary/5 rounded-sm">
                      {tag}
                    </span>
                  ))}
                </div>
              )}

              <div class="flex items-center text-sm font-mono text-text/50 group-hover:text-text transition-colors pt-2">
                <span>ACCESS BRIEFING</span>
                <svg class="w-4 h-4 ml-2 transform group-hover:translate-x-2 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                </svg>
              </div>
            </a>
          </div>

          <div class="w-full md:w-1/2 pl-12 md:pl-0">
             {project.data.coverImage && (
              <a href={`/projects/${project.slug}`} class="block overflow-hidden rounded-sm border border-white/10 group">
                <img 
                  src={project.data.coverImage} 
                  alt={project.data.title}
                  class="w-full h-auto object-cover grayscale opacity-60 group-hover:grayscale-0 group-hover:opacity-100 transition-all duration-700 transform group-hover:scale-105"
                />
              </a>
             )}
          </div>

        </div>
      ))}
    </div>
  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  // 1. Animate the Red Line (Draws down as you scroll)
  gsap.to("#progress-line", {
    height: "100%",
    ease: "none",
    scrollTrigger: {
      trigger: "#mission-log",
      start: "top center",
      end: "bottom center",
      scrub: true, // Links animation directly to scroll bar
    }
  });

  // 2. Animate Each Project (Fade in + Slide up)
  const nodes = document.querySelectorAll(".project-node");
  
  nodes.forEach((node) => {
    gsap.from(node, {
      opacity: 0,
      y: 50,
      duration: 1,
      scrollTrigger: {
        trigger: node,
        start: "top 80%", // Triggers when top of element hits 80% of viewport
        toggleActions: "play none none reverse",
      }
    });
  });
</script>