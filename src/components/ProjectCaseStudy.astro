---
// ProjectCaseStudy.astro — Dossier for all 7 verified real projects

const projects = [
  {
    title: "PT Lautan Kencana Hidup — Intranet SaaS Platform",
    category: "enterprise",
    client: "PT Lautan Kencana Hidup",
    slug: "lkh-internal-platform",
    problem: "Perusahaan memerlukan platform internal terpusat untuk mengelola operasi bisnis multi-departemen yang sebelumnya berjalan manual dan terfragmentasi.",
    solution: "Merancang arsitektur Intranet SaaS dengan Two-Stage Inventory Management, Work Order tracking, dan Cryptographic Blockchain Ledger menggunakan SHA-256 hash-chaining untuk audit trail yang immutable.",
    tech: ["PostgreSQL", "FastAPI", "React 18", "Zustand", "TanStack Query v5"],
    outcome: "Platform enterprise terpusat dengan integritas data terjamin melalui blockchain ledger dan manajemen inventaris dua tahap."
  },
  {
    title: "Windbreaker AI — Aviation Telemetry Platform",
    category: "enterprise",
    slug: "windbreaker-ai",
    problem: "Industri penerbangan memerlukan prediksi delay penerbangan dan estimasi harga tiket secara real-time berdasarkan data telemetri.",
    solution: "Membangun platform telemetri penerbangan dengan model XGBoost real-time (xgb_flight_delay.pkl, xgb_price.pkl), arsitektur FastAPI stateless JWT authentication, Docker persistence, dan GSAP animated counters untuk dashboard.",
    tech: ["XGBoost", "FastAPI", "Docker", "JWT", "GSAP", "Python"],
    outcome: "Prediksi real-time delay penerbangan dan harga tiket dengan model ML teroptimasi."
  },
  {
    title: "Riset AI Medis — IEEE YESIST12",
    category: "research",
    slug: "tb-detection-comparative-study",
    problem: "Deteksi dini Tuberkulosis dari citra X-ray dada memerlukan model AI dengan akurasi dan interpretabilitas tinggi untuk konteks klinis.",
    solution: "Mengembangkan dan membandingkan arsitektur Hybrid CNN (DenseNet–EfficientNetV2-B3) versus Vision Transformers (Swin & DeiT). Menerapkan visualisasi Grad-CAM untuk interpretasi keputusan model.",
    tech: ["PyTorch", "DenseNet", "EfficientNetV2-B3", "Swin Transformer", "DeiT", "Grad-CAM"],
    outcome: "97.0% Accuracy & F1-Score, 100% Recall untuk kelas Healthy, paper dipresentasikan di IEEE YESIST12."
  },
  {
    title: "PT Indonesia Morowali Industrial Park — E-Recruitment Portal",
    category: "enterprise",
    client: "PT Indonesia Morowali Industrial Park",
    slug: "imip-recruitment",
    problem: "Proses rekrutmen korporat berskala besar memerlukan portal digital untuk validasi berkas massal dan manajemen pelamar terpusat.",
    solution: "Mengembangkan E-Recruitment Portal korporat dengan arsitektur RBAC (Role-Based Access Control), validasi berkas massal, konversi desain Figma ke Laravel Blade/SCSS, dan fitur AI Search menggunakan Livewire.",
    tech: ["Laravel", "Blade", "SCSS", "MySQL", "Livewire", "Figma"],
    outcome: "Portal rekrutmen terpusat yang mampu menangani ribuan pelamar dengan validasi berkas otomatis dan pencarian AI."
  },
  {
    title: "Intelligent IT Help Desk",
    category: "automation",
    slug: "help-desk-ai",
    problem: "Tim IT Support menerima volume tiket tinggi dengan banyak duplikasi yang menyebabkan inefisiensi penyelesaian masalah.",
    solution: "Membangun arsitektur hybrid Laravel monolith + Python/Flask microservice dengan Hugging Face semantic embeddings untuk deteksi tiket duplikat secara otomatis.",
    tech: ["Laravel", "Python", "Flask", "Hugging Face", "Semantic Embeddings"],
    outcome: "Reduksi 40% tiket duplikat, meningkatkan efisiensi tim IT Support."
  },
  {
    title: "Telegram OCR Logistics & Purchasing Bot",
    category: "automation",
    slug: "optical-intel-ocr",
    problem: "Proses pencatatan nota fisik dari supplier dan logistik masih dilakukan secara manual, rawan kesalahan, dan tidak terpusat.",
    solution: "Membangun bot Telegram untuk digitalisasi nota fisik menggunakan engine OpenCV dan Tesseract OCR, dengan task scheduler untuk pemrosesan otomatis dan penyimpanan ke basis data terpusat.",
    tech: ["Python", "OpenCV", "Tesseract OCR", "Telegram Bot API", "SQLite"],
    outcome: "Digitalisasi nota fisik secara otomatis dengan akurasi OCR tinggi ke database terpusat."
  },
  {
    title: "Personal Developer Portfolio",
    category: "portfolio",
    slug: "personal-developer-portfolio",
    problem: "Memerlukan platform personal branding dan showcase proyek yang modern, performan, dan mudah dikelola.",
    solution: "Membangun portfolio website menggunakan Astro SSG dengan React Islands architecture, Three.js untuk elemen 3D interaktif, Tailwind CSS untuk styling, dan Keystatic sebagai Git-based CMS.",
    tech: ["Astro", "React", "Three.js", "Tailwind CSS", "Keystatic CMS"],
    outcome: "Website portfolio SSG dengan performa optimal, CMS terintegrasi, dan arsitektur modern."
  }
];

const categoryStyles: Record<string, string> = {
  research: "bg-[#FFC906]/15 text-[#996F00] border-[#FFC906]/30",
  enterprise: "bg-[#223971]/10 text-[#223971] border-[#223971]/20",
  automation: "bg-[#CB2026]/10 text-[#CB2026] border-[#CB2026]/20",
  portfolio: "bg-gray-100 text-gray-700 border-gray-200"
};

const categoryLabels: Record<string, string> = {
  research: "Riset AI",
  enterprise: "Enterprise",
  automation: "Otomasi",
  portfolio: "Portfolio"
};
---

<section id="projects" class="py-20 md:py-24 max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
  <div class="mb-14">
    <span class="font-mono text-xs tracking-[0.2em] uppercase text-[#223971] font-semibold block mb-3">Portofolio Proyek</span>
    <h2 class="text-3xl md:text-4xl font-bold text-[#111827]">Studi Kasus & Sistem Terbangun</h2>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
    {projects.map((project) => (
      <article class="bg-white rounded-xl border border-[#E5E7EB] overflow-hidden hover:shadow-lg transition-all duration-300 flex flex-col h-full group hover:border-[#223971]/30">
        <div class="p-6 flex-1 flex flex-col">
          <div class="flex items-start justify-between mb-4">
            <span class={`font-mono text-[11px] px-3 py-1 rounded-full border uppercase tracking-wider font-semibold ${categoryStyles[project.category]}`}>
              {categoryLabels[project.category]}
            </span>
          </div>
          
          <h3 class="text-lg font-bold text-[#111827] mb-5 leading-snug group-hover:text-[#223971] transition-colors">
            <a href={`/projects/${project.slug}`}>
              {project.title}
            </a>
          </h3>
          
          <div class="space-y-4 flex-1 text-sm text-[#4B5563]">
            <div>
              <h4 class="font-bold text-[#111827] text-xs uppercase tracking-wider mb-1">Context & Business Problem</h4>
              <p class="leading-relaxed text-[13px]">{project.problem}</p>
            </div>
            
            <div>
              <h4 class="font-bold text-[#111827] text-xs uppercase tracking-wider mb-1">Solution & Architecture</h4>
              <p class="leading-relaxed text-[13px]">{project.solution}</p>
            </div>
            
            <div class="pt-1">
              <h4 class="font-bold text-[#111827] text-xs uppercase tracking-wider mb-2">Technical Stack</h4>
              <div class="flex flex-wrap gap-1.5">
                {project.tech.map((tech) => (
                  <span class="font-mono text-[11px] bg-[#223971]/5 text-[#223971] px-2 py-0.5 rounded font-medium">
                    {tech}
                  </span>
                ))}
              </div>
            </div>
          </div>
        </div>
        
        <div class="bg-gray-50/80 p-5 border-t border-[#E5E7EB] flex flex-col justify-between">
          <div>
            <h4 class="font-bold text-[#111827] text-xs uppercase tracking-wider mb-1">Quantitative Outcome</h4>
            <p class="text-xs text-[#4B5563] font-medium leading-relaxed">{project.outcome}</p>
          </div>
          <div class="mt-4 pt-3 border-t border-gray-200/60 flex justify-end">
            <a href={`/projects/${project.slug}`} class="text-xs font-semibold text-[#223971] hover:text-[#CB2026] inline-flex items-center gap-1 transition-colors">
              Lihat Detail Proyek
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </a>
          </div>
        </div>
      </article>
    ))}
  </div>
</section>
