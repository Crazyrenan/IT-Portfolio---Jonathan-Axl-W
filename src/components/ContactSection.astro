---
// ContactSection.astro — Functional Contact Form, Direct Channels, and Footer
---

<section id="contact" class="py-20 md:py-24 bg-white border-t border-[#E5E7EB]">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="mb-14">
      <span class="font-mono text-xs tracking-[0.2em] uppercase text-[#223971] font-semibold block mb-3">
        Hubungi Saya
      </span>
      <h2 class="text-3xl md:text-4xl font-bold text-[#111827] mb-4">
        Mari Berdiskusi
      </h2>
      <p class="text-[#4B5563] text-base sm:text-lg max-w-2xl leading-relaxed">
        Terbuka untuk peluang kerja full-time, kontrak proyek, kolaborasi riset kecerdasan buatan, atau diskusi seputar rekayasa perangkat lunak.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-5 gap-12 items-start">
      <!-- Left Column: Form (60%) -->
      <div class="lg:col-span-3 bg-[#F9FAFB] p-6 sm:p-8 rounded-xl border border-[#E5E7EB]">
        <form id="contactForm" class="space-y-5">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            <div class="space-y-1.5">
              <label for="contact-name" class="block text-xs font-bold uppercase tracking-wider text-[#111827]">Nama Lengkap</label>
              <input type="text" id="contact-name" required class="w-full border border-gray-300 rounded-lg px-4 py-2.5 text-sm focus:ring-2 focus:ring-[#223971] focus:border-transparent outline-none transition bg-white" placeholder="Nama Anda" />
            </div>
            <div class="space-y-1.5">
              <label for="contact-email" class="block text-xs font-bold uppercase tracking-wider text-[#111827]">Email</label>
              <input type="email" id="contact-email" required class="w-full border border-gray-300 rounded-lg px-4 py-2.5 text-sm focus:ring-2 focus:ring-[#223971] focus:border-transparent outline-none transition bg-white" placeholder="email@domain.com" />
            </div>
          </div>
          <div class="space-y-1.5">
            <label for="contact-subject" class="block text-xs font-bold uppercase tracking-wider text-[#111827]">Subjek Pesan</label>
            <input type="text" id="contact-subject" required class="w-full border border-gray-300 rounded-lg px-4 py-2.5 text-sm focus:ring-2 focus:ring-[#223971] focus:border-transparent outline-none transition bg-white" placeholder="Peluang Kerja / Kolaborasi Riset" />
          </div>
          <div class="space-y-1.5">
            <label for="contact-message" class="block text-xs font-bold uppercase tracking-wider text-[#111827]">Pesan</label>
            <textarea id="contact-message" rows="4" required class="w-full border border-gray-300 rounded-lg px-4 py-2.5 text-sm focus:ring-2 focus:ring-[#223971] focus:border-transparent outline-none transition bg-white resize-y" placeholder="Tuliskan rincian pesan atau tawaran kerja sama Anda di sini..."></textarea>
          </div>
          <button type="submit" class="bg-[#CB2026] text-white px-8 py-3 rounded-lg font-semibold hover:bg-[#a81a1f] transition shadow-md shadow-red-500/20 w-full sm:w-auto text-sm">
            Kirim Pesan
          </button>
        </form>
      </div>

      <!-- Right Column: Direct Links (40%) -->
      <div class="lg:col-span-2">
        <div class="bg-white rounded-xl border border-[#E5E7EB] p-6 sm:p-7 shadow-sm">
          <h3 class="text-base font-bold text-[#111827] uppercase tracking-wider mb-5 border-b border-gray-100 pb-3">
            Tautan Langsung
          </h3>
          <div class="flex flex-col space-y-1">
            <a href="mailto:axlwibowo@gmail.com" class="flex items-center gap-3.5 text-[#4B5563] hover:text-[#223971] transition py-3.5 border-b border-gray-100 group">
              <div class="p-2 bg-gray-50 rounded-lg group-hover:bg-[#223971]/10 text-[#223971] transition-colors flex-shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
              </div>
              <div class="truncate">
                <div class="text-xs text-gray-400 uppercase font-mono">Email Pribadi</div>
                <div class="font-medium text-sm text-[#111827]">axlwibowo@gmail.com</div>
              </div>
            </a>
            
            <a href="https://github.com/Crazyrenan" target="_blank" rel="noopener noreferrer" class="flex items-center gap-3.5 text-[#4B5563] hover:text-[#223971] transition py-3.5 border-b border-gray-100 group">
              <div class="p-2 bg-gray-50 rounded-lg group-hover:bg-[#223971]/10 text-[#223971] transition-colors flex-shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>
              </div>
              <div class="truncate">
                <div class="text-xs text-gray-400 uppercase font-mono">GitHub Profile</div>
                <div class="font-medium text-sm text-[#111827]">github.com/Crazyrenan</div>
              </div>
            </a>
            
            <a href="https://linkedin.com/in/jonathan-axl-w" target="_blank" rel="noopener noreferrer" class="flex items-center gap-3.5 text-[#4B5563] hover:text-[#223971] transition py-3.5 group">
              <div class="p-2 bg-gray-50 rounded-lg group-hover:bg-[#223971]/10 text-[#223971] transition-colors flex-shrink-0">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect width="4" height="12" x="2" y="9"/><circle cx="4" cy="4" r="2"/></svg>
              </div>
              <div class="truncate">
                <div class="text-xs text-gray-400 uppercase font-mono">LinkedIn Profile</div>
                <div class="font-medium text-sm text-[#111827]">in/jonathan-axl-w</div>
              </div>
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- Footer -->
    <div class="border-t border-gray-200 mt-16 pt-8 pb-4 flex flex-col md:flex-row justify-between items-center gap-4 text-xs text-[#4B5563]">
      <p>&copy; 2026 Jonathan Axl Wibowo. Dibangun dengan Astro SSG &amp; Tailwind CSS.</p>
      <p class="font-semibold text-[#223971]">Sistem Informasi &mdash; Universitas Multimedia Nusantara</p>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('contactForm');
  
  if (form) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      
      const name = (document.getElementById('contact-name') as HTMLInputElement)?.value || '';
      const email = (document.getElementById('contact-email') as HTMLInputElement)?.value || '';
      const subject = (document.getElementById('contact-subject') as HTMLInputElement)?.value || '';
      const message = (document.getElementById('contact-message') as HTMLTextAreaElement)?.value || '';
      
      const mailtoSubject = encodeURIComponent(subject || `Pesan dari ${name}`);
      const mailtoBody = encodeURIComponent(`Nama: ${name}\nEmail: ${email}\n\nPesan:\n${message}`);
      
      window.location.href = `mailto:axlwibowo@gmail.com?subject=${mailtoSubject}&body=${mailtoBody}`;
    });
  }
</script>
