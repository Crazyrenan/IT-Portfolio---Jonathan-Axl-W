---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

// 1. Generate a new path for every project
export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map(project => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

// 2. Get the specific project data
const { project } = Astro.props;
const { Content } = await project.render();
---

<Layout title={`${project.data.title} | Tactical Elegance`}>
  <main class="min-h-screen px-4 py-20 max-w-4xl mx-auto">
    
    <a href="/" class="inline-flex items-center text-sm text-neutral/50 hover:text-primary transition-colors mb-8 font-mono">
      ← RETURN TO BASE
    </a>

    <header class="mb-12 border-b border-white/10 pb-12">
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
        <div>
          <span class="font-mono text-primary text-sm tracking-widest uppercase">
            {project.data.date.toISOString().split('T')[0]}
          </span>
          <h1 class="text-4xl md:text-5xl font-bold text-white mt-2">
            {project.data.title}
          </h1>
        </div>

        {project.data.githubUrl && (
          <a 
            href={project.data.githubUrl} 
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center px-6 py-3 bg-surface border border-white/10 text-white hover:border-primary hover:text-primary transition-all rounded-sm font-mono text-sm group"
          >
            <span>VIEW SOURCE</span>
            <svg class="w-4 h-4 ml-2 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </a>
        )}
      </div>
    </header>
    
    {project.data.coverImage && (
      <div class="mb-12 border border-white/10 p-2 bg-surface rounded-sm">
        <img 
          src={project.data.coverImage} 
          alt={project.data.title} 
          class="w-full h-auto max-h-[500px] object-cover rounded-sm grayscale-[20%] hover:grayscale-0 transition-all duration-500"
        />
      </div>
    )}

    <article class="prose prose-lg prose-invert max-w-3xl mx-auto prose-headings:uppercase prose-headings:tracking-wider prose-img:w-full">
      <Content />
    </article>

  </main>
</Layout>