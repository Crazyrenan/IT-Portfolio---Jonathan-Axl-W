---
import { getCollection } from 'astro:content';
import TacticalCard from '../3d/TacticalCard';

const allStatus = await getCollection('status');
const publishedStatus = allStatus.filter(mission => mission.data.published === true);
const sortedStatus = publishedStatus.sort((a, b) => 
  new Date(b.data.lastUpdate).valueOf() - new Date(a.data.lastUpdate).valueOf()
);
if (sortedStatus.length === 0) return null;
---

<div class="container mx-auto px-6 mb-16 relative z-20">
  
  <div class="flex items-center gap-3 mb-8 opacity-80">
    <div class="h-px flex-grow bg-gradient-to-r from-primary-glow/50 via-primary/30 to-transparent"></div>
    <span class="font-mono text-xs text-primary-glow tracking-[0.2em] uppercase">
      // CURRENT_OPERATIONAL_STATUS
    </span>
    <div class="h-px w-8 bg-primary-glow/50"></div>
  </div>

  <div class="space-y-8">
    {sortedStatus.map(async (mission) => {
      const { title, status, tech, githubUrl } = mission.data;
      const { Content } = await mission.render();

      return (
        <TacticalCard client:visible depth={22} className="!p-0">
          <div class="relative bg-surface/40 p-6 md:p-8 flex flex-col md:flex-row gap-8 items-start">
            
            <div class="md:w-1/3 border-b md:border-b-0 md:border-r border-primary/30 pb-6 md:pb-0 md:pr-6 w-full">
              <div class="flex items-center gap-4 mb-2">
                <h3 class="text-2xl md:text-3xl font-bold text-text tracking-tight group-hover:text-primary-glow transition-colors">
                  {title}
                </h3>
                {githubUrl && (
                  <a href={githubUrl} target="_blank" rel="noopener noreferrer" class="text-text/40 hover:text-primary-glow transition-colors">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path></svg>
                  </a>
                )}
              </div>
              <p class="font-mono text-xs text-text/50 uppercase tracking-wider">
                Phase: <span class="text-primary-glow font-bold">{status}</span>
              </p>
            </div>

            <div class="md:w-2/3 w-full">
              <div class="prose prose-invert prose-sm mb-4 text-text/80">
                <Content />
              </div>
              <div class="flex flex-wrap gap-2">
                {tech.map(t => (
                  <span class="text-[10px] font-mono text-text/70 bg-background border border-primary/40 px-2.5 py-1 rounded-xs">
                    {t}
                  </span>
                ))}
              </div>
            </div>

          </div>
        </TacticalCard>
      );
    })}
  </div>
</div>

