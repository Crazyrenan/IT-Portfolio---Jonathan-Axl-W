---
interface Props {
  title: string;
  tagline: string;
  image: string;
  slug: string;
  techStack: string[];
}

const { title, tagline, image, slug, techStack } = Astro.props;
---

<a 
  href={`/projects/${slug}`}
  class="tactical-card group relative block w-full h-[400px] bg-surface rounded-sm border border-white/10 overflow-hidden"
>
  <div class="glow-bg absolute inset-0 transition-opacity duration-500 opacity-0 group-hover:opacity-100 rounded-sm z-0"></div>
  
  <div class="absolute inset-0 border border-transparent group-hover:border-primary/50 transition-colors duration-300 z-20 pointer-events-none rounded-sm"></div>

  <div class="card-content relative h-full flex flex-col z-10 bg-surface">
    
    <div class="relative h-1/2 overflow-hidden border-b border-white/5">
      <div class="absolute inset-0 bg-black/20 z-10 group-hover:bg-transparent transition-colors duration-500"></div>
      <img
        src={image}
        alt={title}
        class="w-full h-full object-cover grayscale contrast-125 group-hover:grayscale-0 group-hover:contrast-100 group-hover:scale-105 transition-all duration-700 ease-out"
      />
      <div class="absolute top-2 right-2 w-2 h-2 border-t border-r border-primary/50 opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
    </div>

    <div class="relative h-1/2 p-6 flex flex-col justify-between">
      
      <div class="sheen absolute inset-0 bg-gradient-to-tr from-white/0 via-white/5 to-white/0 pointer-events-none -z-10 opacity-0 group-hover:opacity-10"></div>

      <div>
        <div class="flex items-center justify-between mb-2">
          <span class="font-mono text-[10px] text-primary tracking-widest uppercase opacity-0 group-hover:opacity-100 transition-opacity duration-300 translate-y-2 group-hover:translate-y-0">
            // Classified
          </span>
        </div>
        
        <h3 class="text-2xl font-bold text-white font-sans tracking-tight mb-2 group-hover:text-primary transition-colors duration-300">
          {title}
        </h3>
        
        <p class="text-sm font-mono text-white/50 line-clamp-2">
          {tagline}
        </p>
      </div>

      <div class="flex flex-wrap gap-2 mt-4">
        {techStack.map((tech) => (
          <span class="px-2 py-1 text-[10px] font-mono uppercase tracking-wider text-white/60 bg-white/5 border border-white/10 rounded-sm group-hover:border-primary/30 group-hover:text-primary/80 transition-colors duration-300">
            {tech}
          </span>
        ))}
      </div>
    </div>
  </div>
</a>

<style>
  /* 3D Perspective Setup */
  .tactical-card {
    perspective: 1000px;
    transform-style: preserve-3d;
  }

  .card-content {
    /* Menggunakan variabel CSS yang diupdate oleh JS di bawah */
    transform: rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg));
    transition: transform 0.1s ease-out; /* Smooth follow */
    transform-style: preserve-3d;
    backface-visibility: hidden;
  }

  .glow-bg {
    background: radial-gradient(circle at var(--mx, 50%) var(--my, 50%), rgba(230, 30, 50, 0.15), transparent 70%);
  }

  .sheen {
    background-position: var(--mx, 50%) var(--my, 50%);
  }
</style>

<script>
  // Logic 3D Tilt menggunakan Vanilla JS (berjalan di browser)
  const cards = document.querySelectorAll('.tactical-card');

  cards.forEach((card) => {
    const element = card as HTMLElement;
    const content = card.querySelector('.card-content') as HTMLElement;

    element.addEventListener('mousemove', (e) => {
      const rect = element.getBoundingClientRect();
      const x = e.clientX - rect.left;
      const y = e.clientY - rect.top;

      // Hitung persentase posisi mouse (-0.5 sampai 0.5)
      const xPct = (x / rect.width) - 0.5;
      const yPct = (y / rect.height) - 0.5;

      // Update CSS Variables untuk rotasi (Tilt Effect)
      // -7deg sampai 7deg max rotation
      content.style.setProperty('--rx', `${yPct * -14}deg`); 
      content.style.setProperty('--ry', `${xPct * 14}deg`);

      // Update posisi glow/sheen
      element.style.setProperty('--mx', `${(x / rect.width) * 100}%`);
      element.style.setProperty('--my', `${(y / rect.height) * 100}%`);
    });

    element.addEventListener('mouseleave', () => {
      // Reset ke posisi semula saat mouse keluar
      content.style.setProperty('--rx', '0deg');
      content.style.setProperty('--ry', '0deg');
      element.style.setProperty('--mx', '50%');
      element.style.setProperty('--my', '50%');
    });
  });
</script>