---
// RetroTaskbar.astro — Classic Windows 95 System Taskbar
---

<div class="fixed bottom-0 left-0 right-0 z-50 bg-[#c0c0c0] border-t-2 border-white flex items-center p-1 font-[Tahoma,sans-serif] text-black shadow-[0px_-1px_0px_#808080] select-none h-10">
  
  <div class="flex items-center gap-2 h-full">
    <!-- START Button -->
    <a href="#hero" class="win95-raised px-2.5 py-1 flex items-center gap-1.5 font-bold text-xs h-full active:border-t-[#808080] active:border-l-[#808080] active:border-b-white active:border-r-white active:bg-[#dfdfdf] no-underline text-black">
      <img src="https://win98icons.alexmeub.com/icons/png/windows-0.png" alt="Start" class="w-4 h-4" />
      <span class="mt-0.5">Start</span>
    </a>
  </div>

  <div class="hidden sm:flex items-center gap-1.5 ml-3 h-full flex-1 overflow-x-auto">
    <!-- Active Windows Tabs -->
    <a href="#hero" class="win95-sunken px-2 py-1 flex items-center gap-1.5 text-xs h-full font-bold w-28 md:w-32 truncate bg-[#dfdfdf] text-black no-underline">
      <img src="https://win98icons.alexmeub.com/icons/png/paint_file-1.png" alt="icon" class="w-3.5 h-3.5 flex-shrink-0" />
      <span class="truncate">Profile.bmp</span>
    </a>
    <a href="#skills" class="win95-raised px-2 py-1 flex items-center gap-1.5 text-xs h-full w-28 md:w-32 truncate hover:bg-[#dfdfdf] text-black no-underline">
      <img src="https://win98icons.alexmeub.com/icons/png/hardware_wiz-1.png" alt="icon" class="w-3.5 h-3.5 flex-shrink-0" />
      <span class="truncate">Skills.exe</span>
    </a>
    <a href="#projects" class="win95-raised px-2 py-1 flex items-center gap-1.5 text-xs h-full w-28 md:w-32 truncate hover:bg-[#dfdfdf] text-black no-underline">
      <img src="https://win98icons.alexmeub.com/icons/png/directory_open_file_mydocs-4.png" alt="icon" class="w-3.5 h-3.5 flex-shrink-0" />
      <span class="truncate">Projects.exe</span>
    </a>
    <a href="#experience" class="win95-raised px-2 py-1 flex items-center gap-1.5 text-xs h-full w-28 md:w-32 truncate hover:bg-[#dfdfdf] text-black no-underline">
      <img src="https://win98icons.alexmeub.com/icons/png/notepad_file-2.png" alt="icon" class="w-3.5 h-3.5 flex-shrink-0" />
      <span class="truncate">Log.txt</span>
    </a>
    <a href="#contact" class="win95-raised px-2 py-1 flex items-center gap-1.5 text-xs h-full w-28 md:w-32 truncate hover:bg-[#dfdfdf] text-black no-underline">
      <img src="https://win98icons.alexmeub.com/icons/png/envelope_closed-0.png" alt="icon" class="w-3.5 h-3.5 flex-shrink-0" />
      <span class="truncate">Contact.exe</span>
    </a>
  </div>

  <div class="flex items-center gap-2 h-full ml-auto">
    <!-- System Tray -->
    <div class="win95-sunken px-2 flex items-center h-full gap-2 text-black bg-[#dfdfdf]">
      <img src="https://win98icons.alexmeub.com/icons/png/loudspeaker_rays-0.png" alt="Volume" class="w-3.5 h-3.5" />
      <span id="retro-clock" class="text-xs font-mono font-bold">00:00:00</span>
    </div>
  </div>

</div>

<script>
  function updateClock() {
    const clockEl = document.getElementById('retro-clock');
    if (!clockEl) return;
    
    const now = new Date();
    const options: Intl.DateTimeFormatOptions = { 
      timeZone: 'Asia/Jakarta',
      hour: '2-digit',
      minute: '2-digit',
      second: '2-digit',
      hour12: false
    };
    const timeString = new Intl.DateTimeFormat('en-GB', options).format(now);
    clockEl.textContent = `${timeString}`;
  }

  updateClock();
  setInterval(updateClock, 1000);
</script>
