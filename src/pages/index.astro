---
import Layout from '../layouts/Layout.astro';
import Hero3D from '../components/Hero3D';
import Manifesto from '../components/Manifesto.astro';
import MissionLog from '../components/Missionlog.astro'; 
import NeuralDecryptor from '../components/NeuralDecryptor'; 
import ContactTerminal from '../components/ContactTerminal.astro';
import About from '../components/About.astro';
import TechArsenal from '../components/TechArsenal.astro';
---

<Layout title="Jaws | Full Stack Engineer">
  
  <section class="relative h-screen flex flex-col items-center justify-center overflow-hidden">
    <Hero3D client:load />
    
    <div class="z-10 text-center space-y-6 pointer-events-none select-none">
      <div class="inline-block px-4 py-2 bg-white/5 border border-white/10 rounded-full backdrop-blur-md mb-4">
        <span class="text-primary font-mono text-xs tracking-[0.3em] uppercase">System Online</span>
      </div>
      
      <h1 class="text-7xl md:text-9xl font-bold text-white tracking-tighter">
        Jonathan Axl Wibowo
      </h1>
      
      <p class="text-lg md:text-xl text-neutral/60 font-mono tracking-widest uppercase">
        Full-Stack Engineering <span class="text-primary mx-2">×</span> Intelligent Data
      </p>
    </div>

    <div class="absolute bottom-12 animate-bounce">
      <svg class="w-6 h-6 text-white/30" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
      </svg>
    </div>
  </section>

  <Manifesto />

  <About />

  <TechArsenal />

  <NeuralDecryptor client:visible />

  <MissionLog />

  <ContactTerminal />

</Layout>