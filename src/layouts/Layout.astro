---
import '@fontsource/space-grotesk';
import '@fontsource/jetbrains-mono';
import { ClientRouter } from 'astro:transitions';
import SpyCursor from '../components/interactive/SpyCursor';
import Navbar from '../components/navigation/Navbar.astro';
import TacticalOverlay from '../components/navigation/TacticalOverlay.astro';
import TacticalCanvas from '../components/3d/TacticalCanvas';
import ScrollConnector from '../components/navigation/ScrollConnector.astro';

// Import Global Styles
import '../styles/global.css'; 

interface Props {
  title: string;
}

const { title } = Astro.props;
---


<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="Jonathan Axl Wibowo - Full Stack Engineer" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <ClientRouter />
  </head>


  <body class="font-sans antialiased min-h-screen overflow-x-hidden relative selection:bg-primary-glow selection:text-background"
        style="background-color: rgb(var(--color-bg)); color: rgb(var(--color-text));">
    
    <!-- Ambient Semi-3D Web3 Canvas Layer -->
    <TacticalCanvas client:idle />

    <div class="fixed inset-0 z-[40] pointer-events-none">
      <TacticalOverlay /> 
    </div>
    <div class="fixed inset-0 z-[60] pointer-events-none">
      <SpyCursor client:load /> 
    </div>

    <!-- Scroll progress connector â€” left side rail -->
    <ScrollConnector />

    <div id="site-wrapper" class="relative z-10 opacity-0"> 
      <Navbar />
      <main class="flex-grow flex flex-col relative w-full">
        <slot />
      </main>
    </div>


    <script>
      function revealSite() {
        const wrapper = document.getElementById('site-wrapper');
        if (!wrapper) return;
        requestAnimationFrame(() => {
          wrapper.style.transition = "opacity 0.3s cubic-bezier(0.2, 0, 0, 1), transform 0.3s cubic-bezier(0.2, 0, 0, 1)";
          wrapper.style.opacity = "1";
          wrapper.style.transform = "scale(1)";
        });
      }

      revealSite();
      
      document.addEventListener('astro:after-swap', () => {
        const wrapper = document.getElementById('site-wrapper');
        if (wrapper) {
          wrapper.style.opacity = "0"; 
          wrapper.style.transform = "scale(0.98)"; 
          setTimeout(revealSite, 10); 
        }
      });
    </script>

    <script>
      // ── GSAP ScrollTrigger — Astro View Transitions safety net ──────────────
      // Belt-and-suspenders: kills any ScrollTrigger instances the component
      // cleanup (ctx.revert) might have missed, then refreshes on new DOM.
      import { gsap } from 'gsap';
      import { ScrollTrigger } from 'gsap/ScrollTrigger';
      gsap.registerPlugin(ScrollTrigger);

      document.addEventListener('astro:before-swap', () => {
        ScrollTrigger.getAll().forEach((st) => st.kill());
      });

      document.addEventListener('astro:after-swap', () => {
        ScrollTrigger.refresh();
      });
    </script>
  </body>
</html>
