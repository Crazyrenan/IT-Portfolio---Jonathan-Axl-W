---
import { socialLinks } from '../config/site';

// FIX: Convert the config Object into an Array so we can loop over it
const links = [
  { name: 'GitHub', href: socialLinks.github },
  { name: 'LinkedIn', href: socialLinks.linkedin },
  { name: 'Email', href: `mailto:${socialLinks.email}` }
];

const currentYear = new Date().getFullYear();
---

<footer id="contact" class="bg-surface border-t border-primary/20 pt-20 pb-10 mt-20 font-mono transition-colors duration-500">
  <div class="max-w-4xl mx-auto px-6">
    
    <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-start">
      
      <div class="bg-background border border-primary/20 rounded-sm p-6 shadow-2xl transition-colors duration-500">
        
        <div class="flex gap-2 mb-4 border-b border-primary/10 pb-2">
          <div class="w-3 h-3 rounded-full bg-red-500/80"></div>
          <div class="w-3 h-3 rounded-full bg-yellow-500/80"></div>
          <div class="w-3 h-3 rounded-full bg-green-500/80"></div>
        </div>

        <div class="space-y-4 text-sm font-mono">
          <div class="flex">
            <span class="text-primary mr-2">$</span>
            <span class="text-text/70">initiate_contact_sequence</span>
          </div>
          
          <div class="text-text/60 pl-4 border-l border-primary/20">
            <p>Target: Jonathan Axl Wibowo</p>
            <p>Status: <span class="text-green-500">Available for Hire</span></p>
            <p>Location: Tangerang, ID</p>
          </div>

          <div class="flex">
             <span class="text-primary mr-2">➜</span>
             <a href={`mailto:${socialLinks.email}`} class="text-text hover:text-primary underline decoration-primary/30 underline-offset-4 transition-colors">
               Send_Email_Transmission()
             </a>
          </div>

          <p class="text-text">
            > <span class="inline-block w-2 h-4 bg-primary align-middle animate-pulse"></span>
          </p>
        </div>
      </div>

      <div class="space-y-8">
        <div>
          <h3 class="text-text font-bold text-lg mb-4 flex items-center">
            <span class="w-2 h-2 bg-primary mr-2"></span>
            TRANSMISSION CHANNELS
          </h3>
          <div class="space-y-3">
            {links.map((link) => (
              <a 
                href={link.href}
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center text-text/60 hover:text-primary hover:translate-x-2 transition-all duration-300 group"
              >
                <span class="mr-3 opacity-0 group-hover:opacity-100 transition-opacity text-primary">></span>
                {link.name}
              </a>
            ))}
          </div>
        </div>

        <div>
           <h3 class="text-text font-bold text-lg mb-4 flex items-center">
            <span class="w-2 h-2 bg-primary mr-2"></span>
            SYSTEM STATUS
          </h3>
          <p class="text-text/60 text-sm leading-relaxed">
            All systems operational. <br />
            Built with <span class="text-primary">Astro</span> + <span class="text-primary">Tailwind</span> + <span class="text-primary">React</span>.
            <br />
            <br />
            &copy; {currentYear} Jonathan Axl Wibowo.
          </p>
        </div>
      </div>

    </div>
  </div>
</footer>