---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await project.render();

// Format tanggal agar terlihat profesional
const formattedDate = project.data.date 
  ? new Date(project.data.date).toLocaleDateString('en-US', {
      year: 'numeric',
      month: 'long',
    })
  : 'Mission Pending';
---

<Layout title={`${project.data.title} | Mission Log`}>
  <main class="pt-32 pb-20 px-6 min-h-screen">
    
    <article class="max-w-6xl mx-auto">
      
      <header class="mb-16 border-b border-primary/20 pb-10">
        <a href="/" class="inline-flex items-center text-sm font-mono text-text/60 hover:text-primary mb-8 transition-colors group">
          <svg class="w-4 h-4 mr-2 transform group-hover:-translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
          </svg>
          // RETURN TO BASE
        </a>

        <div class="flex flex-col md:flex-row md:items-end justify-between gap-6">
          <h1 class="text-4xl md:text-6xl font-bold text-text tracking-tight leading-tight">
            {project.data.title}
            <span class="text-primary">.</span>
          </h1>
          
          <div class="font-mono text-sm text-primary border border-primary/30 px-3 py-1 rounded-sm bg-surface/50">
            {formattedDate}
          </div>
        </div>
      </header>


      <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
        
        <div class="lg:col-span-2">
          <div class="prose prose-lg max-w-none 
            prose-headings:text-text prose-headings:font-bold
            prose-p:text-text/80 prose-p:leading-relaxed
            prose-strong:text-primary
            prose-a:text-primary prose-a:no-underline hover:prose-a:underline
            prose-li:text-text/80
            prose-code:text-primary prose-code:bg-surface prose-code:px-1 prose-code:rounded
            prose-blockquote:border-l-primary prose-blockquote:text-text/70 prose-blockquote:bg-surface/30 prose-blockquote:py-2 prose-blockquote:px-4
            ">
            <Content />
          </div>

          {project.data.gallery && project.data.gallery.length > 0 && (
            <div class="mt-20 border-t border-primary/20 pt-12">
              <h3 class="font-mono text-primary text-sm tracking-widest uppercase mb-8 flex items-center">
                <span class="w-2 h-2 bg-primary mr-3 rounded-full animate-pulse"></span>
                ADDITIONAL INTEL / SCREENSHOTS
              </h3>
              
              <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                {project.data.gallery.map((image) => (
                  <div class="group relative overflow-hidden border border-primary/10 bg-surface rounded-sm shadow-sm hover:shadow-lg transition-all duration-300">
                    <div class="absolute inset-0 bg-primary/10 opacity-0 group-hover:opacity-100 transition-opacity duration-300 z-10 pointer-events-none"></div>
                    <img 
                      src={image} 
                      alt="Evidence" 
                      class="w-full h-auto object-cover grayscale-[20%] group-hover:grayscale-0 group-hover:scale-105 transition-all duration-700"
                    />
                  </div>
                ))}
              </div>
            </div>
          )}
        </div>


        <aside class="space-y-8">
          
          <div class="bg-surface border border-primary/20 p-6 rounded-sm shadow-lg sticky top-32">
            <h3 class="text-xs font-mono text-text/50 uppercase tracking-widest mb-6 border-b border-primary/10 pb-2">
              Technology Arsenal
            </h3>
            
            <div class="flex flex-wrap gap-2">
              {project.data.tags.map((tag) => (
                <span class="text-xs font-mono px-3 py-1 bg-background border border-primary/10 text-text/80 rounded-sm hover:border-primary/50 transition-colors cursor-default">
                  {tag}
                </span>
              ))}
            </div>

            {project.data.githubUrl && (
              <div class="mt-8 pt-6 border-t border-primary/10">
                <a 
                  href={project.data.githubUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex items-center justify-center w-full py-3 bg-background border border-primary/30 text-text font-mono text-sm hover:bg-primary hover:text-white transition-all duration-300 group rounded-sm"
                >
                  <svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 24 24">
                    <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd" />
                  </svg>
                  ACCESS SOURCE
                </a>
              </div>
            )}
          </div>
        </aside>

      </div>
      
      <div class="mt-20 pt-10 border-t border-primary/10 text-center">
        <p class="font-mono text-xs text-text/40">
          // END OF TRANSMISSION // {project.data}
        </p>
      </div>

    </article>
  </main>
</Layout>