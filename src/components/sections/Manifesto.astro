<section id="manifesto" class="min-h-screen flex items-center justify-center relative z-10 bg-transparent px-6 transition-colors duration-500">
  <div class="max-w-4xl mx-auto text-center">
    
    <div id="manifesto-content" class="manifesto-text space-y-12 opacity-0 translate-y-20 filter blur-sm">
      <p class="text-xl md:text-2xl font-mono text-[#D12636] tracking-widest uppercase flex items-center justify-center gap-2">
        <span class="w-2 h-2 rounded-full bg-[#D12636] animate-pulse"></span>
        // IDENTITY VERIFIED
      </p>
      
      <h2 class="text-4xl md:text-6xl font-bold text-[#E0D5C9] leading-tight tracking-tight">
        I don't just build websites. <br />
        <span class="text-[#E0D5C9]/40 italic font-mono text-3xl md:text-5xl">I engineer intelligent systems.</span>
      </h2>
      
      <p class="text-lg md:text-xl text-[#E0D5C9]/70 max-w-2xl mx-auto leading-relaxed font-mono">
        Leveraging <span class="text-[#D12636] font-bold">Laravel</span> for structure, 
        <span class="text-[#D12636] font-bold">Python</span> for logic, and 
        <span class="text-[#D12636] font-bold">AI</span> for foresight.
      </p>
    </div>

  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  document.addEventListener('astro:page-load', () => {
    gsap.to(".manifesto-text", {
      scrollTrigger: {
        trigger: "#manifesto",
        start: "top 80%",
        toggleActions: "play none none reverse",
        onRefresh: (self) => {
          if (self.progress > 0) gsap.set(".manifesto-text", { opacity: 1, y: 0, filter: "blur(0px)" });
        }
      },
      opacity: 1,
      y: 0,
      filter: "blur(0px)",
      duration: 1.5,
      ease: "power4.out",
    });
  });
</script>
